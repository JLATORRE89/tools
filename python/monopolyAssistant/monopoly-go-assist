# Boutique block puzzle: calibrated from the 2026-10-04 phone recording.
# Require fully observed connected drawer shapes, including material-bearing cells.
_BOUTIQUE_LAST_FRAME = None
_BOUTIQUE_FAILED = set()


def _boutique_gold(rgb):
