_dig_attempts = {}
_dig_level = None


def treasure_level():
    # Event-specific level header plus the blue display case; no board guessing.
    image = screen_image()
    r,g,b = image.getpixel((540,800))
    if not (b > r + 30 and b > g + 15):
        return None
    match = re.search(r'LEVEL\s+(\d+)\s*/\s*18',
                      ocr_region((350,170,740,245),psm=7).upper())
    return int(match.group(1)) if match and 1 <= int(match.group(1)) <= 18 else None


def treasure_tiles(image):
    # Connected blue star glyphs, not every blue pixel or fixed grid coordinates.
    points=set()
    for y in range(1150,1900,3):
        for x in range(160,925,3):
            r,g,b=image.getpixel((x,y))[:3]
            if (55 <= r <= 90 and 120 <= g <= 158 and 205 <= b <= 245) or (r > 210 and g > 165 and b < 130):
                points.add((x,y))
    result=[]
    while points:
        start=points.pop(); todo=[start]; group=[start]
        while todo:
            x,y=todo.pop()
            for dx,dy in ((3,0),(-3,0),(0,3),(0,-3)):
                neighbor=(x+dx,y+dy)
                if neighbor in points and (image.getpixel(neighbor)[0] > 210) == (image.getpixel(start)[0] > 210):
                    points.remove(neighbor);todo.append(neighbor);group.append(neighbor)
        xs=[p[0] for p in group];ys=[p[1] for p in group]
        w=max(xs)-min(xs);h=max(ys)-min(ys)
        center=((min(xs)+max(xs))//2,(min(ys)+max(ys))//2)
        yellow=sum(image.getpixel(p)[0] > 210 for p in group) > len(group)*0.8
        if yellow:
            # Gold star is a reinforced tile, not an unplayable board decoration.
            corners=[image.getpixel((center[0]+dx,center[1]+dy)) for dx,dy in ((-45,-45),(45,-45),(-45,45),(45,45))]
            blue=sum(c[2] > 180 and c[2] > c[0]+65 and c[2] > c[1]+40 for c in corners)
            if 35 <= w <= 100 and 35 <= h <= 100 and blue >= 2:
                result.append(center)
        elif 20 <= w <= 65 and 20 <= h <= 65 and len(group)>=35:
            result.append(center)
    return sorted(result,key=lambda p:(abs(p[0]-540)+abs(p[1]-1500),p))


class TreasureWatchdog:
    def __init__(self):
        self.reset()

    def reset(self):
        self.started = None
        self.progress_at = None
        self.signature = None

    def update(self, signature):
        now = time.monotonic()
        if self.started is None:
            self.started = self.progress_at = now
        if signature != self.signature:
            self.signature = signature
            self.progress_at = now
        return now - self.progress_at >= 45


_treasure_watchdog = TreasureWatchdog()
_treasure_exit_retry = 0.0


def leave_treasure(reason):
    global _treasure_exit_retry
    report_phase('leaving_treasure')
    if time.monotonic() < _treasure_exit_retry:
        time.sleep(5)
        return True
    print(f'Leaving treasure event: {reason}.')
    # Prefer the observed event close X over Back, which this event may ignore.
    for _ in range(2):
        screenshot()
        if treasure_level() is None:
            _treasure_watchdog.reset()
            print('Treasure event closed; returning to normal screen handling.')
            return True
        tap(540,2245)
        time.sleep(1.5)
    screenshot()
    if treasure_level() is None:
        _treasure_watchdog.reset()
        print('Treasure event closed; returning to normal screen handling.')
    else:
        game_back()
        _treasure_exit_retry = time.monotonic() + 30
        print('Close not yet confirmed; next verified exit attempt in 30 seconds.')
    return True


def handle_treasure():
    global _dig_level, _dig_attempts
    level=treasure_level()
    if level is None:
        return False
    report_phase('treasure_dig')
    if level != _dig_level:
        _dig_level=level;_dig_attempts={}
    title=ocr_region((120,450,980,680),psm=11).upper()
    if 'TREASURES FOUND' in title:
        if _treasure_watchdog.update((level,'reward')):
            return leave_treasure('reward screen made no progress')
        button=find_green_button()
        if button and _confirmed_reward_button(button):
            tap(*button)
        time.sleep(3)
        return True
    count=ocr_region((525,2070,660,2165),psm=7).strip()
    if not re.fullmatch(r'\d{1,3}',count):
        if _treasure_watchdog.update((level,'unreadable')):
            return leave_treasure('hammer count unreadable for 45 seconds')
        print('Treasure hammer count unreadable; waiting without tile taps.')
        time.sleep(3)
        return True
    if int(count)==0:
        return leave_treasure('no hammers remaining')
    if _treasure_watchdog.update((level,int(count))):
        return leave_treasure('no progress for 45 seconds')
    for point in treasure_tiles(screen_image()):
        center_color=screen_image().getpixel(point)
        key=(round(point[0]/10),round(point[1]/10),center_color[0]>210)
        if _dig_attempts.get(key,0)>=2:
            continue
        _dig_attempts[key]=_dig_attempts.get(key,0)+1
        print(f'Treasure level {level}: uncovering verified tile {point}; hammers={count}.')
        tap(*point);time.sleep(2)
        return True
    print('Treasure animation or unrecognized grid; waiting without blind taps.')
    time.sleep(3)
    return True


def _build_footer_matches(text):
    """Named city plus its 0..30 landmark progress, in the bottom footer only."""
    return bool(re.search(r"[A-Za-z][A-Za-z '\u2019.-]{2,}\s+(?:[0-9]|[12][0-9]|30)\s*/\s*30\b", text))


def _main_board_footer_matches(text):
    """Identify board navigation even when sparkle-heavy OCR misses the dice."""
    upper = text.upper()
    labels = sum(bool(re.search(r'\b' + label + r'\b', upper))
                 for label in ('WINS', 'ALBUM', 'FRIENDS'))
    if labels >= 2 and re.search(r'\b\d+\s*/\s*\d+\b', text):
        return True
    # BUILD menus replace this navigation footer with city/landmark progress.
    # All four board labels provide independent evidence when the stylized
    # dice fraction is omitted; fewer labels still require the fraction.
    return labels == 3 and bool(re.search(r'\bBUILD\b', upper))


def is_build_menu_open():
    """Detects whether the BUILD menu is currently open (see constant
    definition for why this exists - recovering from a failed close-tap
    that would otherwise leave the bot stuck indefinitely).

    Requires an olive/warm tint (r and g meaningfully above b), not just a
    generic dark grey - confirmed live 2026-09-07 that a jail "ROLL
    DOUBLES" event screen's police-officer uniform put a neutral dark grey
    (81,83,80, no tint) at the same check point, which the original looser
    range (just bounding r/g/b independently) matched anyway. That caused
    a real stuck-loop incident (repeatedly "closing" a BUILD menu that
    was never actually open). The real badge (93,87,63) has r-b=30, g-b=24;
    the false positive has r-b=1, g-b=3 - a clear, reliable gap.

    Falls back to OCR-ing the card-price row (see BUILD_PRICE_ROW_BOX) when
    the color check fails - confirmed live 2026-09-07 that a themed event
    skin recolors the check-point background, and a fixed color sample
    can't cover every future reskin.

    A second, live 2026-09-07 incident showed the OCR fallback alone isn't
    enough either: once 4 of 5 slots are already maxed out (showing a
    small green checkmark instead of a price), tesseract could not
    reliably read the one remaining price ("446K" repeatedly came back as
    garbage like "AAKK"/"MKK" no matter how the crop was preprocessed -
    a genuine font-legibility limit, not a crop-calibration problem), so
    the OCR path found 0 matches even with the threshold already lowered
    to 1. Real consequence: the menu sat open with an affordable 446K
    item untouched while the loop concluded "never opened", skipped the
    visit, then misread the occluded roll pill as empty and entered a 2h
    backoff.

    Third fallback: detect the checkmark icons directly by color/density
    instead of reading text. Checked once OCR also fails to reach the
    1-match threshold. A maxed-out slot's checkmark and a purchasable
    slot's cash icon are both the same saturated green as a COLLECT
    button (see _is_dismiss_green) - but naively scanning for that hue
    across a wide area re-triggers the exact grass/foliage false-positive
    already fixed in find_green_button() (confirmed live: a raid screen's
    grass sampled 1-6 stray matching pixels in this row's y-band). The
    fix here is density, not hue: a real checkmark/icon fills its slot
    solidly (measured live: 31-32 matching samples in a tight per-slot
    window), while stray grass only clips 0-6. Requiring 15+ matches
    within a narrow +/-20px column around each of the 5 known slot
    x-positions cleanly separates the two.

    OCR match is case-SENSITIVE (uppercase K/M only) - confirmed live
    2026-09-08 that this false-positived on an entirely normal main
    board, stuck cycling "BUILD menu found open (unexpectedly)" forever.
    Cause: this game's tile price labels use an "M" currency prefix (seen
    on-screen as e.g. "M1,000") and tesseract garbled some board text
    into a stray "720m" - a case-INsensitive match on a single lowercase
    'm' fragment was enough to pass the (already-lowered-to-1) threshold.
    Every genuine price observed so far ("446K", "112K", "76.6K", ...) is
    rendered uppercase - requiring that specifically rejects this class
    of garbage match without needing to raise the match-count threshold
    back up (which would break the mostly-maxed-slots case this fallback
    exists for)."""
    from PIL import Image
    img = screen_image()
    footer = ocr_region((0, 2110, 1080, 2300), psm=6)
    if _main_board_footer_matches(footer):
        return False
    # Sparkle frames can also confuse block segmentation enough to omit a
    # navigation label. Read its text-only row before considering green icons.
    navigation = ocr_region((0, 2200, 1080, 2260), psm=7)
    if _main_board_footer_matches(navigation):
        return False
    r, g, b = img.getpixel(BUILD_MENU_CHECK_POINT)
    if 70 < r < 130 and 65 < g < 120 and 40 < b < 100 and (r - b) > 15 and (g - b) > 10:
        return True
    # Theme-independent footer stays readable when stylized prices do not.
    if _build_footer_matches(footer):
        return True
    text = ocr_region(BUILD_PRICE_ROW_BOX, psm=6)
    price_matches = re.findall(r"\d[\d,.]*\s*[KM]\b", text)
    if len(price_matches) >= 1:
        return True
    for x in BUILD_CARD_XS:
        matches = 0
        for y in range(2030, 2055, 2):
            for dx in range(-20, 21, 4):
                if _is_dismiss_green(img.getpixel((x + dx, y))):
                    matches += 1
        if matches >= 15:
            return True
    return False

