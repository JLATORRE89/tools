def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        print('Command timed out; treating result as unavailable.')
        return subprocess.CompletedProcess(cmd, 124, '', 'timeout')

def is_device_connected():
    """True iff adb currently sees exactly one authorized, ready device."""
    result = sh(f"{ADB} get-state")
    return result.returncode == 0 and result.stdout.strip() == "device"

_frame_cache = None
_frame_signature = None
_ocr_cache = {}


def screen_image():
    """Decode each captured frame once; invalidate on file replacement/change."""
    global _frame_cache, _frame_signature
    from PIL import Image
    stat = os.stat(SCREENSHOT)
    signature = (SCREENSHOT, stat.st_mtime_ns, stat.st_size, stat.st_ino)
    if signature != _frame_signature:
        with Image.open(SCREENSHOT) as image:
            _frame_cache = image.convert("RGB")
        _frame_signature = signature
        _ocr_cache.clear()
    return _frame_cache


def decode_raw_frame(data):
    """Reject partial, rotated, or unsupported captures before any pixel access."""
    import struct
    from PIL import Image
    if len(data) < 12:
        raise ValueError('capture header missing')
    w, h, fmt = struct.unpack('<III', data[:12])
    if (w, h) != (1080, 2340) or fmt != 1:
        raise ValueError('unsupported capture geometry or pixel format')
    payload = w * h * 4
    header = len(data) - payload
    if header not in (12, 16):
        raise ValueError('capture pixel payload incomplete')
    return Image.frombytes('RGBA', (w, h), data[header:]).convert('RGB')


def screenshot():
    """Wait safely on disconnects; never publish or act on a partial frame."""
    global _frame_cache, _frame_signature
    while True:
        try:
            measured_at = time.monotonic() if os.environ.get('MONOPOLY_METRICS') == '1' else None
            if not is_device_connected():
                raise ConnectionError('device disconnected or not authorized')
            if _continuous_mode:
                focus = subprocess.run([ADB, 'shell', 'dumpsys', 'window'],
                                       capture_output=True, text=True, timeout=5)
                if focus.returncode or not _game_has_focus(focus.stdout):
                    report_phase('waiting_for_game_focus')
                    time.sleep(15)
                    continue
            result = subprocess.run([ADB, 'exec-out', 'screencap'],
                                    capture_output=True, timeout=15)
            if result.returncode:
                raise ValueError('capture command failed')
            img = decode_raw_frame(result.stdout)
            temporary = SCREENSHOT + '.next.png'
            img.save(temporary, compress_level=1)
            os.replace(temporary, SCREENSHOT)
            stat = os.stat(SCREENSHOT)
            _frame_cache = img
            _frame_signature = (SCREENSHOT, stat.st_mtime_ns, stat.st_size, stat.st_ino)
            _ocr_cache.clear()
            if measured_at is not None:
                record_timing('capture', time.monotonic() - measured_at)
            if _phase in ('waiting_for_device', 'waiting_for_game_focus', 'capture_unavailable'):
                report_phase('evaluating_screen')
            return
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            if not _continuous_mode:
                print(f'Capture unavailable: {exc}', file=sys.stderr)
                raise SystemExit(1)
            report_phase('waiting_for_device' if isinstance(exc, ConnectionError) else 'capture_unavailable')
            time.sleep(15)


_ocr_api = None


def ocr_image(image, psm=7, tsv=False):
    measured_at = time.monotonic() if os.environ.get('MONOPOLY_METRICS') == '1' else None
    try:
        return _recognize_image(image, psm, tsv)
    finally:
        if measured_at is not None:
            record_timing('ocr', time.monotonic() - measured_at)


def _recognize_image(image, psm=7, tsv=False):
    """Optional reusable engine; fresh recognition state for every image."""
    global _ocr_api
    if os.environ.get('MONOPOLY_INPROCESS_OCR') == '1':
        try:
            if _ocr_api is None:
                from tesserocr import PyTessBaseAPI
                _ocr_api = PyTessBaseAPI(
                    path=os.environ.get('TESSDATA_PREFIX', '/usr/share/tesseract-ocr/5/tessdata'),
                    lang='eng')
                _ocr_api.SetVariable('debug_file', os.devnull)
                atexit.register(_ocr_api.End)
            _ocr_api.Clear()
            _ocr_api.ClearAdaptiveClassifier()
            _ocr_api.SetPageSegMode(psm)
            _ocr_api.SetImage(image)
            if not _ocr_api.Recognize(timeout=30000):
                return ''
            return _ocr_api.GetTSVText(0) if tsv else _ocr_api.GetUTF8Text().strip()
        except (ImportError, RuntimeError, OSError) as exc:
            print(f'In-process OCR unavailable: {exc}; using command-line OCR.')
    image.save(_CROP)
    suffix = ' tsv' if tsv else ''
    return sh(f"tesseract {_CROP} - --psm {psm}{suffix} 2>/dev/null").stdout.strip()


def ocr_region(box, psm=7):
    from PIL import Image
    img = screen_image()
    key = (tuple(box), psm)
    if key in _ocr_cache:
        return _ocr_cache[key]
    crop = img.crop(box)
    _ocr_cache[key] = ocr_image(crop, psm)
    return _ocr_cache[key]

