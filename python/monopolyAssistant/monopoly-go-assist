        btn = find_green_button(y_start=700, y_end=2340)
        if not btn:
            break
        print(f"Claiming reward button at {btn}.")
        tap(*btn)
        time.sleep(1.3)
    screenshot()
    tap(*GENERIC_BOTTOM_CLOSE_X)
    time.sleep(1.0)

def is_build_menu_open():
    """Detects whether the BUILD menu is currently open (see constant
    definition for why this exists - recovering from a failed close-tap
    that would otherwise leave the bot stuck indefinitely).

    Requires an olive/warm tint (r and g meaningfully above b), not just a
    generic dark grey - confirmed live 2026-09-07 that a jail "ROLL
    DOUBLES" event screen's police-officer uniform put a neutral dark grey
    (81,83,80, no tint) at the same check point, which the original looser
    range (just bounding r/g/b independently) matched anyway. That caused
    a real stuck-loop incident (repeatedly "closing" a BUILD menu that
    was never actually open). The real badge (93,87,63) has r-b=30, g-b=24;
    the false positive has r-b=1, g-b=3 - a clear, reliable gap.

    Falls back to OCR-ing the card-price row (see BUILD_PRICE_ROW_BOX) when
    the color check fails - confirmed live 2026-09-07 that a themed event
    skin recolors the check-point background, and a fixed color sample
    can't cover every future reskin.

    A second, live 2026-09-07 incident showed the OCR fallback alone isn't
    enough either: once 4 of 5 slots are already maxed out (showing a
    small green checkmark instead of a price), tesseract could not
    reliably read the one remaining price ("446K" repeatedly came back as
    garbage like "AAKK"/"MKK" no matter how the crop was preprocessed -
    a genuine font-legibility limit, not a crop-calibration problem), so
    the OCR path found 0 matches even with the threshold already lowered
    to 1. Real consequence: the menu sat open with an affordable 446K
    item untouched while the loop concluded "never opened", skipped the
    visit, then misread the occluded roll pill as empty and entered a 2h
    backoff.

    Third fallback: detect the checkmark icons directly by color/density
    instead of reading text. Checked once OCR also fails to reach the
    1-match threshold. A maxed-out slot's checkmark and a purchasable
    slot's cash icon are both the same saturated green as a COLLECT
    button (see _is_dismiss_green) - but naively scanning for that hue
    across a wide area re-triggers the exact grass/foliage false-positive
    already fixed in find_green_button() (confirmed live: a raid screen's
    grass sampled 1-6 stray matching pixels in this row's y-band). The
    fix here is density, not hue: a real checkmark/icon fills its slot
    solidly (measured live: 31-32 matching samples in a tight per-slot
    window), while stray grass only clips 0-6. Requiring 15+ matches
    within a narrow +/-20px column around each of the 5 known slot
    x-positions cleanly separates the two.

    OCR match is case-SENSITIVE (uppercase K/M only) - confirmed live
    2026-09-08 that this false-positived on an entirely normal main
    board, stuck cycling "BUILD menu found open (unexpectedly)" forever.
    Cause: this game's tile price labels use an "M" currency prefix (seen
    on-screen as e.g. "M1,000") and tesseract garbled some board text
    into a stray "720m" - a case-INsensitive match on a single lowercase
    'm' fragment was enough to pass the (already-lowered-to-1) threshold.
    Every genuine price observed so far ("446K", "112K", "76.6K", ...) is
    rendered uppercase - requiring that specifically rejects this class
    of garbage match without needing to raise the match-count threshold
    back up (which would break the mostly-maxed-slots case this fallback
    exists for)."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    r, g, b = img.getpixel(BUILD_MENU_CHECK_POINT)
    if 70 < r < 130 and 65 < g < 120 and 40 < b < 100 and (r - b) > 15 and (g - b) > 10:
        return True
    text = ocr_region(BUILD_PRICE_ROW_BOX, psm=6)
    price_matches = re.findall(r"\d[\d,.]*\s*[KM]\b", text)
    if len(price_matches) >= 1:
        return True
    for x in BUILD_CARD_XS:
        matches = 0
        for y in range(2030, 2055, 2):
            for dx in range(-20, 21, 4):
                if _is_dismiss_green(img.getpixel((x + dx, y))):
                    matches += 1
        if matches >= 15:
            return True
    return False

def _is_match3_gold(rgb):
    r, g, b = rgb
    return r > 200 and 170 < g < 240 and 50 < b < 110

def is_match3_screen():
    """Majority (>=5 of 12) of the grid points reading as gold card-back
    means we're on the match-3 screen. Tolerant of some tiles already
    being flipped (revealed tiles are dark with an icon, not gold) by the
    time this runs, and of the two 'reward' slots at top-left of the grid
    which aren't tappable tiles and read as other colors."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    gold_count = sum(
        1 for y in MATCH3_TILE_YS for x in MATCH3_TILE_XS
        if _is_match3_gold(img.getpixel((x, y)))
    )
    return gold_count >= 5

def is_card_popup_screen():
    """Detects a Chance/Community Chest/other card popup via the board-
    dimming overlay it applies (see calibration note above), rather than
    matching any one card's specific interior color - covers 'any number
    of cards' per the user, as long as they share this same dimmed-modal
    presentation."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    return all(c < 100 for c in img.getpixel(CARD_DIM_CHECK_POINT))

def _is_dismiss_green(rgb):
    r, g, b = rgb
    return g > 150 and g > r + 30 and g > b + 60

def find_green_button(min_width=250, max_height=200, min_size=80, y_start=2100, y_end=2340):
    """Dynamically finds a green, button-shaped blob within a search band
    (default: bottom third of the screen) - COLLECT, BOARD COMPLETE's
    GO!, TAP TO CLAIM!, and other reward-dismissal buttons all turn out to
    share this color/shape regardless of the specific popup design around
    them. Uses proper connected-components clustering, not a single fixed
    point or a naive 'topmost matching pixel' scan - confirmed live
    2026-09-07 both were necessary: at least 3 different popup designs
    (match-3 COLLECT, BOARD COMPLETE, and a 'Net Worth Gallery' reward
    reveal) each placed this button at a meaningfully different Y
    coordinate (2100-2130 range), and a naive topmost-pixel scan picked up
    an unrelated green UI element on at least one screen instead of the
    actual button. Filters candidate blobs by a button-like shape (wide,
    moderate height) and picks the largest. y_start/y_end let callers
    search elsewhere (e.g. the WINS/Quick Wins screen, whose claim buttons
    sit mid-screen, not in the usual bottom band). Returns a safe tap
    point on the button's solid-color top band (not its text), or None if
    no such blob is found.

    Rejects a shape-matching blob if its matched pixels aren't color-
    uniform - confirmed live 2026-09-07 a raid screen's background grass/
    foliage (color (131,180,105) at one specific point) passed the hue
    check AND clustered into a wide, button-shaped blob on a grassy board,
    causing an infinite stuck loop (repeatedly 'tapping' a nonexistent
    COLLECT button on top of an active raid, since is_collect_screen()
    checks this before anything else per explicit user direction). A real
    button's fill is a flat, near-solid color; grass/foliage is textured.
    Measured live: matched pixels within a genuine GO button had stdev
    ~(11,8,13) per channel, vs ~(28,14,21) for the false-positive grass
    patch - clear, reliable gap. Only the winning (largest) candidate is
    checked, and rejection returns None outright (skip this tick) rather
    than falling back to a smaller candidate - a second real button
    existing simultaneously is not a real scenario worth risking a wrong
    guess over.

    Default y_start raised from 1900 to 2100 (2026-09-08) after the
    flatness check above turned out not to be sufficient either: some
    boards have a big, perfectly flat/solid lawn patch (not textured like
    the grass case above) sitting around y~1908-2088 - measured live at
    stdev ~(2,3,2), actually FLATTER than a real button, so it passed the
    uniformity check too. Two separate live incidents confirmed this (a
    plain undimmed main board with nothing else going on, and a raid
    screen), both with a real, fully-matching flat-green blob in that
    band causing the same infinite stuck-tapping loop. Real buttons are
    documented (see above) to only ever appear at y 2100-2130 - the
    original y_start=1900 gave 200px of unused, false-positive-prone
    margin below the lowest real button ever observed. Verified 2100
    excludes both known flat-lawn false positives while a y_start of
    2050 or 2080 still let the raid one through - 2100 is the tightest
    boundary that matches the documented real range exactly."""
    from PIL import Image
    from collections import deque
    img = Image.open(SCREENSHOT).convert("RGB")
    step = 4
    pts = set()
    for y in range(y_start, y_end, step):
        for x in range(0, 1080, step):
            if _is_dismiss_green(img.getpixel((x, y))):
                pts.add((x, y))
    remaining = set(pts)
    clusters = []
    neighbor_dist = step * 2
    while remaining:
        start = remaining.pop()
        comp = [start]
        q = deque([start])
        while q:
            cx, cy = q.popleft()
            near = [
                p for p in remaining
                if abs(p[0] - cx) <= neighbor_dist and abs(p[1] - cy) <= neighbor_dist
            ]
            for p in near:
                remaining.discard(p)
                comp.append(p)
                q.append(p)
        clusters.append(comp)
    candidates = []
    for comp in clusters:
        xs = [p[0] for p in comp]
        ys = [p[1] for p in comp]
        w = max(xs) - min(xs)
        h = max(ys) - min(ys)
        if w > min_width and h < max_height and len(comp) > min_size:
            candidates.append((len(comp), min(xs), max(xs), min(ys), comp))
    if not candidates:
        return None
    candidates.sort(key=lambda c: c[0], reverse=True)
    _, x0, x1, y0, comp = candidates[0]
    colors = [img.getpixel(p) for p in comp]

    def _pstdev(vals):
        mean = sum(vals) / len(vals)
        return (sum((v - mean) ** 2 for v in vals) / len(vals)) ** 0.5

    r_std = _pstdev([c[0] for c in colors])
    g_std = _pstdev([c[1] for c in colors])
    b_std = _pstdev([c[2] for c in colors])
    if r_std > 20 or g_std > 16 or b_std > 18:
        return None
    return ((x0 + x1) // 2, y0 + 8)

def is_board_complete_screen():
    """Detects the 'BOARD COMPLETE!' celebration screen - now just an
    alias for the general green-button finder (see find_green_button);
    kept as a named function since the main loop and RULES.md both refer
    to this screen by name."""
    return find_green_button() is not None

def is_switch_opponent_menu():
    """Detects the 'SWITCH OPPONENT / Target a different player' sub-menu.
    Two-stage check: a cheap color pre-filter (the gold/tan 'REVENGE' tab
    background) followed by an OCR confirmation of the actual title text
    if the color matches. The color alone isn't reliable enough for a
    top-level check (see constant definition - it also matches an ordinary
    yellow board tile), so OCR gates the final decision; the OCR call is
    cheap in practice since it only runs on the rare ticks where the color
    pre-filter already matched."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    r, g, b = img.getpixel(SWITCH_OPPONENT_MENU_CHECK_POINT)
    color_match = 195 < r < 235 and 175 < g < 215 and 95 < b < 140
    if not color_match:
        return False
    text = ocr_region(SWITCH_OPPONENT_TITLE_OCR_REGION).upper()
    return "SWITCH" in text or "OPPONENT" in text

def is_color_wheel_screen():
    """Detects the Color Wheel bonus prize-spinner screen (see constant
    definition)."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    r, g, b = img.getpixel(COLOR_WHEEL_CHECK_POINT)
    return 80 < r < 160 and 130 < g < 200 and 60 < b < 140 and g > r and g > b

def is_quit_dialog_present():
    """Detects the 'Would you like to quit the game?' confirmation dialog
    (see constant definition).

    Gated behind is_card_popup_screen() first - confirmed live 2026-09-08
    that the bare color check alone false-positived on an ordinary
    undimmed main board (a yellow-roofed building on one particular
    opponent's board sampled (224,190,96) at the check point, close
    enough to the real CANCEL button's (242,184,83) to match the same
    loose range), causing an infinite "tapping CANCEL" loop on a
    completely normal screen. Confirmed live the real dialog always dims
    the board first (CARD_DIM_CHECK_POINT read (36,34,29) on a genuine
    dialog vs (241,235,220) on the false-positive board) - same dimming
    gate already used for find_orange_x_button() and
    is_pick_a_box_screen() above, for the same reason."""
    if not is_card_popup_screen():
        return False
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    r, g, b = img.getpixel(QUIT_DIALOG_CHECK_POINT)
    return 200 < r < 255 and 150 < g < 210 and b < 110

def _is_orange_x_color(rgb):
    r, g, b = rgb
    return r > 200 and 70 < g < 130 and b < 70

def find_orange_x_button(min_cluster=8):
    """SAFETY-CRITICAL: dynamically searches the top-right region for an
    orange circular X close button, used by real-money purchase-upsell
    popups. Does NOT trust one fixed point - confirmed live 2026-09-07
    that different upsell designs place this X at meaningfully different
    coordinates (~30-70px apart between two chained popups seen back to
    back). Requires a minimum cluster of matching points (not just one
    pixel) to rule out stray colorful confetti/decoration elsewhere on
    screen - confirmed this filters out a real false-positive single-pixel
    hit on the (unrelated, non-purchase) Invite Friends popup. Returns a
    safe tap point on the ring itself, not the blob's bounding-box center
    (which lands on the white X glyph drawn in the middle - also confirmed
    live), or None if no such button is found."""
    from PIL import Image
    img = Image.open(SCREENSHOT).convert("RGB")
    pts = [
        (x, y) for y in range(300, 550, 3) for x in range(800, 1080, 3)
        if _is_orange_x_color(img.getpixel((x, y)))
    ]
    if len(pts) < min_cluster:
        return None
    min_y = min(p[1] for p in pts)
    top_pts = [p for p in pts if p[1] <= min_y + 8]
    cx = sum(p[0] for p in top_pts) // len(top_pts)
    return (cx, min_y + 8)

def is_purchase_upsell_screen():
    """SAFETY-CRITICAL: True if a real-money purchase-upsell popup's
    orange X close button is found (see find_orange_x_button - why this
    must be checked, and handled, separately from the generic card-popup
    branch: never tap this screen's center). Gated behind
    is_card_popup_screen() first - confirmed live 2026-09-07 that
    searching for the orange X unconditionally (i.e. even on an undimmed
    main board) false-positived against the Farm Express event icon."""
    return is_card_popup_screen() and find_orange_x_button() is not None

PICK_A_BOX_OCR_REGION = (270, 1580, 700, 1660)

def is_pick_a_box_screen():
    """Detects the 'Infinite Harvest / PICK A BOX' mini-event - confirmed
    live 2026-09-07 (see RULES.md) that this specific UI does not accept
    ADB-injected touches at all, after 5 different technique attempts, so
    it must be treated as manual-only rather than tapped at. Without this
    detector, the main loop's generic card-popup handler kept firing on
    it every tick (center-tap, then the close-X fallback), neither of
    which do anything here - harmless (no purchase buttons on this
    screen) but a waste of cycles and log noise while waiting for the
    user to actually pick a box themselves.

    Gated behind is_card_popup_screen() first, same reasoning as
    find_orange_x_button() above - OCR is comparatively expensive, so
    only run it on the rare ticks where the cheap dimmed-board color
    check already matched."""
    if not is_card_popup_screen():
        return False
    text = ocr_region(PICK_A_BOX_OCR_REGION).upper()
    return "PICK" in text and "BOX" in text

def is_collect_screen():
    """Detects the green 'COLLECT' reward-popup button (shown after a
    match-3 win and similar rewards, plus turns out to cover BOARD
    COMPLETE's GO! and other reward-reveal popups too - see
    find_green_button). Must be checked before is_match3_screen(), since
    the popup renders on top of the match-3 grid and would otherwise
    block it from being dismissed."""
    return find_green_button() is not None

def get_multiplier():
    """OCR the multiplier badge. Tesseract frequently drops the leading
    'x' on this font, so rather than requiring it, just take the first
    digit 1-3 found anywhere in the cleaned output."""
    text = ocr_region((685, 1700, 765, 1785))
    cleaned = re.sub(r"[^0-9]", "", text)
    for ch in cleaned:
        if ch in "123":
            return int(ch), text
    return None, text

def tap(x, y):
    sh(f"{ADB} shell input tap {x} {y}")

def _keep_screen_awake():
    """Wakes the screen and dismisses a lock screen if one is showing.
    This phone has a real swipe-to-dismiss lock screen (confirmed live
    2026-09-06 - no PIN/pattern, but waking up alone isn't enough, an
    actual swipe is needed). A short swipe (not edge-to-edge) is used so
    that if the screen turns out to already be unlocked on the game board,
    the accidental camera pan this causes is minor rather than a full-
    screen drag."""
    sh(f"{ADB} shell input keyevent KEYCODE_WAKEUP")
    sh(f"{ADB} shell input swipe 540 1700 540 1300 250")

def sleep_keeping_awake(total_s, interval_s=300):
    """Sleeps for total_s, periodically waking/unlocking the screen so it
    doesn't time out and lock during a long wait with no taps to keep it
    awake naturally (critical for the multi-hour roll-empty backoff). Also
    checks for and handles the BUILD badge and card popups at each
    interval - confirmed live (2026-09-06) that a plain blind sleep here
    meant BUILD was never opened for the entire 2h wait even when its
    badge was showing, even though building only needs banked cash, not
    rolls. Also ends the wait early if the roll pill has refilled -
    confirmed live (2026-09-07) that rolls can be topped up externally
    (e.g. a free shop reward gave +29 rolls) mid-backoff, and without this
    check the bot would sit idle for up to the rest of the full 2h even
    with rolls sitting ready. Also handles raid/match3/bonus-roll/switch-
    opponent-menu at each interval (added 2026-09-07) - confirmed live a
    raid can appear right as the loop enters backoff (the raid screen
    occludes the roll pill, causing a false 'empty' reading), and without
    this it sat unaddressed for the rest of a 2h wait."""
    elapsed = 0.0
    while elapsed < total_s:
        chunk = min(interval_s, total_s - elapsed)
        time.sleep(chunk)
        elapsed += chunk
        _keep_screen_awake()
        screenshot()
        if is_quit_dialog_present():
            print("Quit-game dialog detected during backoff wait (unexpected) - tapping CANCEL.")
            tap(*CANCEL_BUTTON)
            continue
        # Checked next, same as the main loop - a COLLECT/GO! button is
        # always safe to grab regardless of what else is going on, per
        # explicit user direction, and previously nothing caught this
        # during the backoff wait at all.
        if is_collect_screen():
            print("COLLECT reward popup detected during backoff wait - tapping it.")
            _drain_collect_popups()
            continue
        if is_build_menu_open():
            print("BUILD menu found open during backoff wait - closing it.")
            tap(*BUILD_CLOSE_X)
            continue
        if is_color_wheel_screen():
            print("Color Wheel bonus spinner detected during backoff wait - tapping SPIN.")
            tap(*SPIN_BUTTON)
            time.sleep(2.0)
            continue
        if is_switch_opponent_menu():
            print("Switch-opponent menu detected during backoff wait - picking Random Player.")
            tap(*RANDOM_PLAYER_GO_BUTTON)
            time.sleep(1.2)
            continue
        if is_match3_screen():
            print("Match-3 mini-game detected during backoff wait - playing it.")
            cmd_match3()
            time.sleep(1.0)
            continue
        if is_bonus_roll_screen():
            print("Bonus 'Roll Doubles' event detected during backoff wait - tapping its ROLL button.")
            tap(*BONUS_ROLL_BUTTON)
            time.sleep(1.0)
            continue
        if is_raid_screen():
            # Confirmed live 2026-09-07: a raid can appear right as the
            # loop enters a long backoff (misreading the pill as empty
            # because the raid screen occludes it), and with nothing
            # handling raids during the wait it sat unaddressed for the
            # rest of the 2h - this is the fix.
            print("Raid screen detected during backoff wait - handling it.")
            cmd_raid()
            time.sleep(1.5)
            continue
        if is_pick_a_box_screen():
            # Manual-only (see RULES.md) - same reasoning as the main loop.
            print("Pick a Box mini-event detected during backoff wait (manual-only) - waiting for you to tap it.")
            continue
        if is_card_popup_screen():
            # Only search for the orange X once we already know we're on
            # SOME dimmed popup - searching unconditionally every tick
            # false-positived against the (undimmed) main board's Farm
            # Express icon, confirmed live 2026-09-07.
            x_btn = find_orange_x_button()
            if x_btn:
                print(f"Purchase upsell detected during backoff wait - tapping X at {x_btn} (never the card body).")
                tap(*x_btn)
                continue
            print("Card popup detected during backoff wait - tapping center to dismiss.")
            tap(*CARD_TAP_POINT)
            time.sleep(1.0)
            screenshot()
            if is_card_popup_screen() and not find_orange_x_button():
                print("Still showing after center tap - trying bottom-center close X fallback.")
                tap(*GENERIC_BOTTOM_CLOSE_X)
            continue
        if is_build_badge_present():
            print("BUILD badge detected during backoff wait - opening BUILD.")
            cmd_build()
        ratio = get_roll_fill_ratio()
        if ratio >= ROLL_RATIO_EMPTY:
            print(f"Rolls have replenished (fill ratio {ratio:.2f}) during backoff wait - ending wait early.")
            return
        _keep_screen_awake()

def long_press(x, y, duration_s=2.5):
    sh(f"{ADB} shell input motionevent DOWN {x} {y}")
    steps = max(1, int(duration_s / 0.24))
    for _ in range(steps):
        time.sleep(0.24)
        sh(f"{ADB} shell input motionevent MOVE {x} {y}")
    sh(f"{ADB} shell input motionevent UP {x} {y}")

def _roll_action():
    """Simplified rule (per live testing): single-tap whenever there's
    anything in the pill at all. Only skip tapping when it's genuinely
    empty (0/0) - in that case signal the caller to back off rather than
    busy-poll, since we can't reliably OCR the countdown timer either.
    Assumes a screenshot has already been taken.

    Does NOT do its own retry/settle logic - an empty reading here can
    also mean we're mid-transition into a raid/match3/bonus-roll/collect
    screen (those have no roll pill either), not genuinely 0 rolls. Since
    an empty result now triggers a full ROLL_EMPTY_BACKOFF_S (2h) sleep,
    that distinction matters a lot - see _settle_before_long_backoff(),
    called by cmd_loop() before it actually commits to sleeping."""
    ratio = get_roll_fill_ratio()
    print(f"roll pill fill ratio: {ratio:.2f}")
    if ratio < ROLL_RATIO_EMPTY:
        print("Pill reads empty (0/0). Not tapping - back off and recheck later.")
        return 2  # distinct code: "empty, caller should back off"
    print("Rolls available: single tap.")
    tap(*GO_BUTTON)
    return 0

def _settle_before_long_backoff(max_wait_s=25, interval_s=3.0):
    """Before committing to the long (multi-hour) empty-rolls backoff,
    keep re-checking for a while in case we're actually mid-transition
    into a raid/match3/bonus-roll/collect screen rather than genuinely
    idle on the main board with 0 rolls. Confirmed live (2026-09-06): a
    raid's intro crane/transition animation outlasted a much shorter
    (2.5s) double-check gap, so both quick checks landed mid-animation and
    falsely confirmed 'empty' - nearly wasting a full 2h sleep instead of
    handling a real raid with 3 targets. Polling for up to max_wait_s
    across all known screen types (not just re-checking the pill) is a
    more thorough guard. Returns True if genuinely still empty/idle after
    the full wait, False if a recognized screen appeared (caller should
    handle that instead of sleeping)."""
    waited = 0.0
    while waited < max_wait_s:
        time.sleep(interval_s)
        waited += interval_s
        screenshot()
        if (is_quit_dialog_present() or is_build_menu_open() or is_card_popup_screen()  # covers purchase upsells too - both are dimmed
                or is_switch_opponent_menu()  # now OCR-confirmed, safe as a top-level check again (2026-09-07)
                or is_collect_screen()
                or is_color_wheel_screen() or is_match3_screen()
                or is_bonus_roll_screen()
                or is_raid_screen()):  # is_collect_screen covers BOARD COMPLETE too
            return False
        if get_roll_fill_ratio() >= ROLL_RATIO_EMPTY:
            return False
    return True

def cmd_roll():
    screenshot()
    return _roll_action()

def _multiplier_action():
    """Assumes a screenshot has already been taken."""
    mult, raw = get_multiplier()
    print(f"multiplier detected: {mult} (raw OCR: {raw!r})")
    if mult is None:
        print("Could not read multiplier via OCR. No action taken.")
        return 1
    if mult >= 3:
        print("Already at cap (x3). Not tapping (would reset to x1).")
        return 0
    print("Tapping multiplier to increase.")
    tap(*MULTIPLIER_BADGE)
    return 0

def cmd_multiplier():
    screenshot()
    return _multiplier_action()

def cmd_status():
    screenshot()
    ratio = get_roll_fill_ratio()
    mult, raw2 = get_multiplier()
    print(f"roll pill fill ratio: {ratio:.2f} ({'EMPTY' if ratio < ROLL_RATIO_EMPTY else 'has rolls'})")
    print(f"multiplier: {mult} (raw: {raw2!r})")
    return 0

def cmd_build(rounds=6):
    """Open BUILD, tap every card slot repeatedly (harmless no-op once
    unaffordable/maxed), close. Does not check cash vs price - relies on
    the game silently no-op'ing on a card you can't afford.

    Taps each of the 5 slots up to `rounds` times per visit, not just
    once. Confirmed live 2026-09-06 that buying a card doesn't leave that
    slot empty - the next purchasable item slides into the same position,
    so repeated taps on one slot can consume several sequential purchases
    (one live test bought 6 buildings across 5 slots in a single manual
    pass). A single tap per slot was leaving cash unspent: confirmed live
    2026-09-07 (user report: "it is sitting on 451k" with the badge still
    showing pending purchases) - one visit only ever touched the first
    affordable item per slot, then moved on, even when much more was
    still affordable afterward. Extra taps past what's actually available
    are harmless no-ops, so this errs toward buying too much rather than
    too little.

    Verifies the close actually worked and retries a few times if not -
    confirmed live 2026-09-07 that a single unverified close tap can fail
    to register, leaving the bot stuck inside the BUILD menu with nothing
    else recognizing or recovering from that state (it sat there for the
    rest of a 2h backoff wait).

    Per-tap delay is 0.15s (down from 0.5s, 2026-09-07 speed-up request) -
    this loop stays inside one already-open static menu the whole time
    (no screen transition per tap), so it doesn't need the longer settle
    time that transition-triggering taps elsewhere in this file require.

    Verifies the menu actually opened before tapping any card slots -
    confirmed live 2026-09-07 that cash can pile up unspent (user report:
    "we are at 2 million... I think it forgot to build") because the open
    tap can silently miss when it lands at the same moment as an unrelated
    animation (caught live: a dice-roll 'DOUBLES' overlay was showing over
    the main board at the exact instant the BUILD tap fired). Without this
    check, cmd_build tapped the 5 card-slot coordinates against whatever
    WAS on screen (the board, mid-animation), then found the menu already
    "closed" (it was never open) and reported success having bought
    nothing - a silent no-op that looked identical to a normal successful
    visit in the logs. Retries the open tap a few times before giving up.

    Waits 1.8s (not 1.0s) before the first open check - confirmed live
    2026-09-07 the menu's open animation consistently needs ~2s to fully
    render the price text the OCR fallback reads, so 1.0s reliably burned
    2 guaranteed-fail retries (with their own screenshot+OCR cost) before
    succeeding on the 3rd every single time."""
    print("Opening BUILD menu.")
    opened = False
    for attempt in range(4):
        tap(*BUILD_ICON)
        time.sleep(1.8)
        screenshot()
        if is_build_menu_open():
            opened = True
            break
        print(f"BUILD menu did not open after tap (attempt {attempt + 1}/4) - retrying.")
    if not opened:
        print("WARNING: BUILD menu never opened - skipping this visit rather than tapping blind.")
        return 1
    for _ in range(rounds):
        for x in BUILD_CARD_XS:
            tap(x, BUILD_CARD_Y)
            time.sleep(0.15)
    print("Closing BUILD menu.")
    for attempt in range(4):
        tap(*BUILD_CLOSE_X)
        time.sleep(1.0)
        screenshot()
        if not is_build_menu_open():
            return 0
        print(f"BUILD menu still open after close tap (attempt {attempt + 1}/4) - retrying.")
    print("WARNING: BUILD menu still open after 4 close attempts - giving up for this tick.")
    return 1

def cmd_match3():
    """Blind-flip all 12 tiles in the 'Match 3 to steal' mini-game grid.
    No memory/strategy - just reveals everything in order. Matches happen
    by chance as pairs/triples line up; good enough for 'handle the basics'
    without a full solver.

    Per-tap delay is 0.25s (down from 0.7s, 2026-09-07 speed-up request) -
    same reasoning as cmd_build: this is a fixed static grid, no screen
    transition between taps, so it doesn't need transition settle time."""
    print("Flipping all 12 tiles in the match-3 grid.")
    for y in MATCH3_TILE_YS:
        for x in MATCH3_TILE_XS:
            tap(x, y)
            time.sleep(0.25)
    return 0

def cmd_loop(interval_s=1.3):
    """Tie it all together: dismiss any Chance/Community Chest/other card
    popup (dimmed-board overlay, any interior color/content), keep
    rolling, top up the multiplier, open BUILD whenever its red badge
    shows something is affordable/pending (with a ~6min fixed-interval
    fallback in case that detector ever misses), auto-detect + play the
    match-3 mini-game whenever it appears, handle the purple-button 'Roll
    Doubles' bonus event (which has no roll pill - without this check
    cmd_roll() reads it as empty and gets stuck), handle raid/heist
    target-selection screens by tapping a detected target reticle (does
    NOT avoid smoke/cooldown targets - still requires visual judgment this
    doesn't attempt; falls back to SWITCH OPPONENT if no target is found),
    and auto-dismiss the green COLLECT reward popup afterward. Backs off
    for ROLL_EMPTY_BACKOFF_S (2h, to let ~10 rolls bank up rather than
    waking for every single one) only once _settle_before_long_backoff()
    confirms the empty reading isn't just a mid-transition frame - a false
    positive is now expensive. During that wait, periodically wakes/
    unlocks the screen so a long idle stretch with no taps doesn't let the
    phone's screen timeout lock it out. Runs until killed (Ctrl-C or an
    external stop)."""
    print(f"Starting continuous loop (card-popup dismissal + roll + "
          f"multiplier + badge-driven build + match-3 auto-play + "
          f"bonus-roll-event + raid-target tapping + collect-popup "
          f"dismissal), checking every {interval_s}s. Ctrl-C to stop.")
    tick = 0
    try:
        while True:
            screenshot()
            if is_quit_dialog_present():
                print("Quit-game dialog detected (unexpected) - tapping CANCEL.")
                tap(*CANCEL_BUTTON)
                time.sleep(1.0)
                continue
            # Checked next, before every other screen type: a COLLECT/GO!
            # button is always safe to grab (pure reward, no downside) and
            # per explicit user direction should be tapped "regardless of
            # the screen" rather than only reached after ruling out every
            # other branch - a chained reward popup can appear on top of
            # almost any other state.
            if is_collect_screen():
                print("COLLECT reward popup detected - tapping it.")
                _drain_collect_popups()
                continue
            if is_build_menu_open():
                print("BUILD menu found open (unexpectedly) - closing it.")
                tap(*BUILD_CLOSE_X)
                time.sleep(1.0)
                continue
            if is_color_wheel_screen():
                print("Color Wheel bonus spinner detected - tapping SPIN.")
                tap(*SPIN_BUTTON)
                time.sleep(2.5)
                continue
            if is_pick_a_box_screen():
                # Manual-only (see RULES.md - 5 touch-injection techniques
                # all failed to register on the crates). Checked before the
                # generic card-popup branch below so it doesn't waste
                # cycles/log spam repeatedly center-tapping and X-fallback
                # tapping a screen that never responds to either.
                print("Pick a Box mini-event detected (manual-only - ADB touch doesn't register here) - waiting for you to tap it.")
                time.sleep(5.0)
                continue
            if is_switch_opponent_menu():
                # Now OCR-confirmed (not just color), safe as a top-level
                # check again - re-added 2026-09-07 after confirming live
                # this screen can otherwise sit stuck indefinitely. Checked
                # before the generic card-popup branch below - moved
                # 2026-09-11 alongside match3/bonus-roll/raid (see note
                # there for why).
                print("Switch-opponent menu detected - picking Random Player.")
                tap(*RANDOM_PLAYER_GO_BUTTON)
                time.sleep(1.2)
                continue
            if is_match3_screen():
                print("Match-3 mini-game detected - playing it.")
                cmd_match3()
                time.sleep(1.0)
                continue
            if is_bonus_roll_screen():
                # Checked before the generic card-popup branch below -
                # confirmed live 2026-09-11 this screen dims the board
                # (matches is_card_popup_screen() too), and since that
                # generic check used to run first, it was swallowing this
                # event every time with an ineffective center-tap,
                # stuck-cycling "Card popup detected... Still showing..."
                # forever and never once reaching this branch. Moved
                # switch-opponent/match3/raid up alongside it for the same
                # reason, even though only bonus-roll was confirmed stuck
                # live - all four have their own dedicated tap target the
                # generic center-tap/close-X fallback can't substitute for.
                print("Bonus 'Roll Doubles' event detected - tapping its ROLL button.")
                tap(*BONUS_ROLL_BUTTON)
                time.sleep(1.0)
                continue
            if is_raid_screen():
                cmd_raid()
                time.sleep(1.5)
                continue
            if is_card_popup_screen():
                # Generic fallback for any OTHER dimmed popup we don't
                # have a specific handler for (Chance/Community Chest
                # etc.) - kept last among the popup-handling checks, after
                # every screen type with its own dedicated tap target
                # above, since a plain center-tap/close-X can't substitute
                # for those (see note on the bonus-roll check above).
                # Only search for the orange X once we already know we're
                # on SOME dimmed popup - searching unconditionally every
                # tick false-positived against the (undimmed) main board's
                # Farm Express icon, confirmed live 2026-09-07.
                x_btn = find_orange_x_button()
                if x_btn:
                    print(f"Purchase upsell detected - tapping X at {x_btn} only (never the card body - real money at stake).")
                    tap(*x_btn)
                    time.sleep(1.2)
                    continue
                print("Card popup detected (dimmed board) - tapping center to dismiss.")
                tap(*CARD_TAP_POINT)
                time.sleep(1.2)
                screenshot()
                if is_card_popup_screen() and not find_orange_x_button():
                    print("Still showing after center tap - trying bottom-center close X fallback.")
                    tap(*GENERIC_BOTTOM_CLOSE_X)
                    time.sleep(1.2)
                continue
            roll_result = _roll_action()
            if roll_result == 2:
                if _settle_before_long_backoff():
                    print(f"Backing off {ROLL_EMPTY_BACKOFF_S}s (rolls empty).")
                    cleanup_temp_images()
                    sleep_keeping_awake(ROLL_EMPTY_BACKOFF_S)
                    _keep_screen_awake()
                else:
                    print("Screen changed during settle-check - re-evaluating immediately.")
                continue
            _multiplier_action()
            tick += 1
            if is_build_badge_present():
                print("BUILD badge detected - opening BUILD.")
                cmd_build()
            elif tick % 277 == 0:  # ~6min fallback safety net in case the
                                    # badge check ever misses something -
                                    # tick count scaled for interval_s=1.3
                                    # (was 90 @ 4s/tick, same 360s cadence)
                cmd_build()
            if is_shop_badge_present():
                cmd_check_shop()
            if tick % 1385 == 0:  # ~30min: WINS has no reliable badge, so
                                   # it's checked on a fixed schedule instead -
                                   # tick count scaled for interval_s=1.3
                                   # (was 450 @ 4s/tick, same 1800s cadence)
                cmd_check_wins()
            time.sleep(interval_s)
    except KeyboardInterrupt:
        print("Loop stopped.")
    return 0

def usage():
    print("Usage: monopoly-go-assist {roll|multiplier|build|match3|raid|shop|wins|loop|status}")
    print()
    print("roll       - single-tap GO if the roll pill isn't empty")
    print("multiplier - OCR multiplier badge, tap it unless already at the x3 cap")
    print("build      - open BUILD, tap all 5 cards once, close")
    print("match3     - blind-flip all 12 tiles in the match-3 mini-game grid")
    print("raid       - find a raid target reticle and tap it (no smoke-avoidance)")
    print("shop       - check the shop for a free daily gift (OCR-gated, never")
    print("             taps a real-money purchase button)")
    print("wins       - claim all available Quick Wins / milestone rewards")
    print("loop       - run everything continuously: roll, multiplier, badge-driven")
    print("             build, match-3, bonus-roll events, raids, shop, and wins")
    print("status     - report roll count and multiplier, no action")

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    actions = {
        "roll": cmd_roll,
        "multiplier": cmd_multiplier,
        "build": cmd_build,
        "match3": cmd_match3,
        "raid": cmd_raid,
        "shop": cmd_check_shop,
        "wins": cmd_check_wins,
        "loop": cmd_loop,
        "status": cmd_status,
    }
    if cmd in actions:
        sys.exit(actions[cmd]())
    usage()
    sys.exit(1)
