if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    actions = {
        "roll": cmd_roll,
        "multiplier": cmd_multiplier,
        "multiplier-max": cmd_multiplier_max,
        "build": cmd_build,
        "match3": cmd_match3,
        "raid": cmd_raid,
        "collect": cmd_collect,
        "shop": cmd_check_shop,
        "wins": cmd_check_wins,
        "loop": cmd_loop,
        "status": cmd_status,
    }
    if cmd in actions:
        if cmd == 'loop':
            import fcntl
            lock_file = open('/tmp/monopoly-go-assist.lock', 'a')
            try:
                fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print('Another automation loop owns the device; not starting a second loop.')
                sys.exit(75)
        sys.exit(actions[cmd]())
    usage()
    sys.exit(1)
