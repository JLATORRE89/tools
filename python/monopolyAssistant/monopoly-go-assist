def _exact_free_boxes(tsv):
    """Observed, high-confidence standalone FREE labels; never substring matches."""
    lines = {}
    for row in tsv.splitlines():
        cols = row.split('\t')
        if len(cols) < 12 or cols[0] != '5' or not cols[11].strip():
            continue
        lines.setdefault(tuple(cols[1:5]), []).append(cols)
    result = []
    for words in lines.values():
        if len(words) != 1:
            continue
        cols = words[0]
        if not re.fullmatch(r'FREE!?', cols[11].strip().upper()):
            continue
        try:
            x, y, width, height = map(int, cols[6:10])
            confidence = float(cols[10])
        except ValueError:
            continue
        if 80 <= confidence <= 100 and x >= 0 and y >= 0 and width > 0 and height > 0:
            result.append((x, y, width, height))
    return result


def _free_offer_context(text):
    """Fail closed on priced, conditional, locked or unfamiliar offer screens."""
    upper = text.upper()
    if re.search(r'[$\u00a3\u20ac\u00a5]|\b\d+[.,]\d{2}\b|\b(?:BUY|PURCHASE|LOCKED|UNLOCK\w*|AFTER|REQUIRES?|SUBSCRIBE|WATCH|EXPIRED|NOT|USD|GBP|EUR)\b', upper):
        return False
    return bool(re.search(r'\b(?:DAILY GIFT|FREE GIFT|FREE REWARD)\b', upper))


def _side_free_icon_candidates():
    """Check both side strips; open only an icon visibly labeled FREE."""
    image = screen_image()
    if image.size != (1080, 2340) or is_card_popup_screen():
        return []
    if not _main_board_footer_matches(ocr_region((0, 2110, 1080, 2300), psm=6)):
        return []
    result = []
    # Search regions only; tap coordinates always come from this frame's OCR.
    for left, top, right, bottom in ((0, 420, 230, 1700), (850, 420, 1080, 1700)):
        tsv = ocr_image(image.crop((left, top, right, bottom)), psm=11, tsv=True)
        for x, y, width, height in _exact_free_boxes(tsv):
            if x + width <= right-left and y + height <= bottom-top and 15 <= height <= 100:
                result.append((left+x+width//2, top+y+height//2))
    return sorted(result, key=lambda p: (p[1], p[0]))


def _confirmed_free_offer_button():
    # Keep purchase dismissal separate; never tap a detected purchase body.
    if is_purchase_upsell_screen():
        return None
    image = screen_image()
    if image.size != (1080, 2340):
        return None
    tsv = ocr_image(image, psm=11, tsv=True)
    text = ' '.join(row.split('\t')[11] for row in tsv.splitlines() if len(row.split('\t')) >= 12)
    if not _free_offer_context(text):
        return None
    candidates = _exact_free_boxes(tsv)
    if len(candidates) != 1:
        return None
    x, y, width, height = candidates[0]
    if not (30 <= width <= 300 and 15 <= height <= 100 and x+width <= 1080 and y+height <= 2340):
        return None
    if not (250 <= x+width//2 <= 830 and 700 <= y+height//2 <= 2130):
        return None
    point = find_green_button(y_start=max(700,y-60), y_end=min(2200,y+height+80))
    if not point or abs(point[0]-(x+width//2)) > 100 or not y-60 <= point[1] <= y+height+80:
        return None
    local = ocr_region((max(0,point[0]-220), max(0,y-20), min(1080,point[0]+220), min(2340,y+height+20)))
    return point if re.fullmatch(r'FREE!?', local.strip().upper()) else None


