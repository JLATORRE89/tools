def cleanup_temp_images():
    # Only our own temporary files may be removed; never other sessions' captures.
    for path in (_RAW_SCREENSHOT, _CROP):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass


_diagnostic_times = {}


def record_diagnostic(reason):
    """Keep at most twelve game screenshots, rate-limited by failure type."""
    if os.environ.get('MONOPOLY_DIAGNOSTICS') != '1':
        return
    now = time.monotonic()
    if now - _diagnostic_times.get(reason, float('-inf')) < 60:
        return
    _diagnostic_times[reason] = now
    try:
        from pathlib import Path
        folder = Path.home() / '.local/state/monopoly-assist/diagnostics'
        folder.mkdir(parents=True, exist_ok=True)
        safe_reason = re.sub(r'[^a-z0-9_-]', '_', reason.lower())
        target = folder / f'{time.time_ns()}-{safe_reason}.png'
        shutil.copyfile(SCREENSHOT, target)
        for old in sorted(folder.glob('*.png'))[:-12]:
            old.unlink()
        print(f'DIAGNOSTIC {reason}: {target}')
    except OSError as exc:
        print(f'Diagnostic capture unavailable: {exc}')


def _is_pill_blue(rgb):
    r, g, b = rgb
    return b > 200 and g > 140 and r < 220 and b > r

_last_die_detected = False

def get_roll_fill_ratio():
    """Color-based proxy for the roll count: fraction of the pill's width
    that's still blue (filled) vs dark-olive (empty). Not an exact count,
    but reliable enough to classify low/medium/high - see calibration notes
    above and in RULES.md."""
    global _last_die_detected
    _last_die_detected = False
    from PIL import Image
    img = screen_image()
    total = ROLL_PILL_X_END - ROLL_PILL_X_START
    blue = sum(
        1 for x in range(ROLL_PILL_X_START, ROLL_PILL_X_END)
        if _is_pill_blue(img.getpixel((x, ROLL_PILL_Y)))
    )
    ratio = blue / total if total else 0.0
    # A tiny remaining fill (live 3/60) is below the historical 3% cutoff.
    # Require a contiguous blue patch across three rows, not a stray pixel.
    if 0 < ratio < ROLL_RATIO_EMPTY:
        for x in range(ROLL_PILL_X_START, min(ROLL_PILL_X_START + 35, ROLL_PILL_X_END - 2)):
            if all(_is_pill_blue(img.getpixel((x + dx, ROLL_PILL_Y + dy)))
                   for dx in range(3) for dy in (-2, 0, 2)):
                return ROLL_RATIO_EMPTY
    if ratio < ROLL_RATIO_EMPTY:
        # Live 1/60 occupies only the rounded left edge, below the old scanline.
        for x in range(ROLL_PILL_X_START - 6, ROLL_PILL_X_START + 6):
            for y in range(ROLL_PILL_Y + 4, ROLL_PILL_Y + 24):
                if all(_is_pill_blue(img.getpixel((x + dx, y + dy)))
                       for dx in range(3) for dy in range(5)):
                    _last_die_detected = (ratio == 0)
                    return ROLL_RATIO_EMPTY
    return ratio

def _is_bonus_roll_purple(rgb):
    """A real purple has a distinct 'green valley' - g meaningfully lower
    than both r and b (calibrated button: 161,117,194 - g is 44/77 below
    r/b). Confirmed live 2026-09-07 the original looser check (just
    b>140, b>g, b>r) also matched a raid board's blue-grey industrial
    background theme (188,189,199 - low-saturation near-grey, not
    purple), causing a persistent false 'Roll Doubles' detection on a
    real raid screen. Requiring the green-valley gap rules out grey/blue
    tones that merely have b>g>r without a real magenta/purple hue."""
    r, g, b = rgb
    return b > 140 and 90 < r < 200 and b > g and b > r and g < r - 20 and g < b - 20

def is_bonus_roll_screen():
    """Detects the 'Roll Doubles' bonus mini-event's purple ROLL button.
    This screen has no roll pill or normal GO button, so cmd_roll() would
    otherwise read the pill as empty and get stuck doing nothing.

    Checks a small 5-point cluster around the button rather than one pixel
    and requires a majority match. Confirmed live (2026-09-06) a single
    stray piece of confetti from a raid-win celebration screen happened to
    land exactly on the one checked pixel with a matching purple color,
    causing this to false-positive repeatedly on a screen that was
    actually a COLLECT popup, not this event at all. A large solid button
    should still cover a small spread of nearby points; a small confetti
    piece is unlikely to cover all of them at once."""
    from PIL import Image
    img = screen_image()
    cx, cy = BONUS_ROLL_BUTTON
    offsets = [(0, 0), (-15, 0), (15, 0), (0, -15), (0, 15)]
    hits = sum(
        1 for dx, dy in offsets
        if _is_bonus_roll_purple(img.getpixel((cx + dx, cy + dy)))
    )
    return hits >= 4

def _color_close(a, b, tol=20):
    return all(abs(a[i] - b[i]) <= tol for i in range(3))

def is_raid_screen():
    """Cheap gate check for the raid/heist target-selection screen: is the
    olive 'SWITCH OPPONENT' button showing at its calibrated point?"""
    from PIL import Image
    img = screen_image()
    return _color_close(img.getpixel(RAID_SWITCH_BUTTON), RAID_SWITCH_BUTTON_COLOR)

def _is_reticle_white(rgb):
    r, g, b = rgb
    return r > 235 and g > 235 and b > 235

def find_raid_targets():
    """Locates the glowing white circular target reticles via a
    connected-components blob scan, restricted to the board content area
    (excludes the header and the SWITCH OPPONENT footer). Reticles have a
    very distinctive, consistent signature - calibrated live 2026-09-06
    against a real 3-target screen: each reticle formed a roughly square
    ~150x150px cluster of ~700 sampled white points, cleanly distinguishable
    from sky/cloud/header/footer noise (which are either much smaller, or
    wide-and-short rather than square). Returns a list of (x,y) centers,
    NOT filtered for smoke/cooldown - that still requires visual judgment
    this doesn't attempt (see RULES.md)."""
    from PIL import Image
    from collections import deque

    img = screen_image()
    w, h = img.size
    px = img.load()
    step = 3
    y0, y1 = 300, 2180

    white_pts = set()
    for y in range(y0, y1, step):
        for x in range(0, w, step):
            if _is_reticle_white(px[x, y]):
                white_pts.add((x, y))

    remaining = set(white_pts)
    clusters = []
    neighbor_dist = step * 2
    while remaining:
        start = remaining.pop()
        comp = [start]
        q = deque([start])
        while q:
            cx, cy = q.popleft()
            # Points lie on a step-spaced grid. Test the same neighborhood
            # directly instead of scanning every remaining point per pixel.
            near = [(cx + dx, cy + dy)
                    for dx in range(-neighbor_dist, neighbor_dist + 1, step)
                    for dy in range(-neighbor_dist, neighbor_dist + 1, step)
                    if (cx + dx, cy + dy) in remaining]
            for p in near:
                remaining.discard(p)
                comp.append(p)
                q.append(p)
        clusters.append(comp)

    targets = []
    for comp in clusters:
        xs = [p[0] for p in comp]
        ys = [p[1] for p in comp]
        cw = max(xs) - min(xs)
        ch = max(ys) - min(ys)
        if 100 <= cw <= 200 and 100 <= ch <= 200 and abs(cw - ch) <= 40 and len(comp) >= 400:
            targets.append(((min(xs) + max(xs)) // 2, (min(ys) + max(ys)) // 2))
    return targets

def _drain_collect_popups(max_extra=6):
    """Taps the current COLLECT popup, then polls for and taps any further
    chained popups. Confirmed live (2026-09-06): reward popups can chain -
    a raid win's COLLECT was immediately followed by a separate 'CONGRATS!
    80,000' event-reward COLLECT. A fixed sleep or single re-check isn't
    enough either way: the transition animation between popups (or between
    a popup and the main board) takes a couple seconds, and a screenshot
    taken too early lands on an in-between frame matching no known screen
    signature - which previously caused the main loop to misread it as
    'rolls empty' and back off 60s instead of collecting a pending reward.
    Polling (rather than guessing a delay or a fixed popup count) handles
    both single and chained popups the same way. Re-finds the button's
    position each time via find_green_button() rather than a fixed point -
    confirmed live 2026-09-07 that different popup designs place it at
    meaningfully different coordinates, so a chained popup's button isn't
    guaranteed to be in the same place as the one that triggered this."""
    if is_purchase_upsell_screen():
        return
    btn = find_collect_button()
    if btn:
        tap(*btn)
    for _ in range(max_extra):
        time.sleep(1.3)
        screenshot()
        if is_purchase_upsell_screen():
            break
        btn = find_collect_button()
        if not btn:
            break
        print(f"Another chained popup detected - tapping green button at {btn}.")
        tap(*btn)

def cmd_raid():
    """Handles the raid/heist target-selection screen: finds target
    reticles and taps one. Does NOT check for smoke/cooldown effects (still
    requires visual judgment - see RULES.md), so this may occasionally tap
    a suboptimal target; if no targets are found at all (detection miss, or
    a screen this heuristic doesn't handle well), falls back to tapping
    SWITCH OPPONENT to get a fresh board rather than getting stuck.

    After tapping a target, a demolition animation plays for a few seconds
    before the reward/COLLECT popup appears - polls for it rather than
    guessing a fixed delay (see _drain_collect_popups for why)."""
    screenshot()
    targets = find_raid_targets()
    if not targets:
        print("Raid screen detected but no targets found - switching opponent.")
        tap(*RAID_SWITCH_BUTTON)
        # SWITCH OPPONENT opens a player-selection menu, not an immediate
        # new board - poll for it and pick Random Player rather than
        # leaving it stuck (confirmed live this doesn't render instantly).
        for _ in range(5):
            time.sleep(1.0)
            screenshot()
            if is_switch_opponent_menu():
                print("Switch-opponent menu detected - picking Random Player.")
                tap(*RANDOM_PLAYER_GO_BUTTON)
                break
        return 1
    print(f"Raid screen: {len(targets)} target(s) found, tapping {targets[0]}.")
    tap(*targets[0])
    for _ in range(8):
        time.sleep(1.0)
        screenshot()
        if is_collect_screen():
            print("Raid reward COLLECT popup detected - tapping it.")
            _drain_collect_popups()
            return 0
    print("No COLLECT popup appeared after raid tap (timed out waiting).")
    record_diagnostic('raid_reward_timeout')
    return 0

