def is_color_wheel_screen():
    """Detects the Color Wheel bonus prize-spinner screen (see constant
    definition)."""
    from PIL import Image
    img = screen_image()
    r, g, b = img.getpixel(COLOR_WHEEL_CHECK_POINT)
    if not (80 < r < 160 and 130 < g < 200 and 60 < b < 140 and g > r and g > b):
        return False
    # A confirmed board footer cannot belong to the full-screen wheel overlay.
    # Avoid expensive outlined-title OCR during every multiplier probe step.
    navigation = ocr_region((0, 2200, 1080, 2260), psm=7)
    if _main_board_footer_matches(navigation):
        return False
    # Net Worth Gallery milestone badges can share this banner color.
    # Confirm the event title before ever treating a tap as a free spin.
    title = ocr_region((180, 300, 900, 690), psm=6)
    title_matches = bool(re.search(r'\bCOLOR\s+WHEEL\b', title.upper()))
    if not title_matches:
        # The current large, outlined heading defeats block segmentation.
        # Read both complete words separately; never repair guessed letters.
        color_key = ('color_wheel_title_mask',)
        if color_key not in _ocr_cache:
            crop = img.crop((250, 330, 850, 465)).convert('RGB')
            mask = Image.new('L', crop.size, 255)
            mask.putdata([0 if red > 220 and green > 190 else 255
                          for red, green, blue in crop.getdata()])
            _ocr_cache[color_key] = ocr_image(
                mask.resize((mask.width * 2, mask.height * 2)), psm=7)
        color = _ocr_cache[color_key]
        wheel_key = ('color_wheel_lower_title_mask',)
        if wheel_key not in _ocr_cache:
            crop = img.crop((240, 465, 850, 640)).convert('RGB')
            mask = Image.new('L', crop.size, 255)
            mask.putdata([0 if red > 220 and green > 190 else 255
                          for red, green, blue in crop.getdata()])
            _ocr_cache[wheel_key] = ocr_image(
                mask.resize((mask.width * 2, mask.height * 2)), psm=7)
        wheel = _ocr_cache[wheel_key]
        title_matches = (bool(re.search(r'\bCOLOR\b', color.upper())) and
                         bool(re.search(r'\bWHEEL\b', wheel.upper())))
    if not title_matches:
        return False
    spin = ocr_region((300, 1820, 800, 1930), psm=7).upper()
    spin = spin.strip(" \t\r\n/\\(),[]'\"")
    remaining = ocr_region((250, 2140, 850, 2270), psm=7).upper().strip()
    return spin == 'SPIN' and bool(re.fullmatch(r'[1-9]\d*\s+SPINS?\s+LEFT', remaining))

def is_quit_dialog_present():
    """Detects the 'Would you like to quit the game?' confirmation dialog
    (see constant definition).

    Gated behind is_card_popup_screen() first - confirmed live 2026-09-08
    that the bare color check alone false-positived on an ordinary
    undimmed main board (a yellow-roofed building on one particular
    opponent's board sampled (224,190,96) at the check point, close
    enough to the real CANCEL button's (242,184,83) to match the same
    loose range), causing an infinite "tapping CANCEL" loop on a
    completely normal screen. Confirmed live the real dialog always dims
    the board first (CARD_DIM_CHECK_POINT read (36,34,29) on a genuine
    dialog vs (241,235,220) on the false-positive board) - same dimming
    gate already used for find_orange_x_button() and
    is_pick_a_box_screen() above, for the same reason."""
    if not is_card_popup_screen():
        return False
    from PIL import Image
    img = screen_image()
    r, g, b = img.getpixel(QUIT_DIALOG_CHECK_POINT)
    if not (200 < r < 255 and 150 < g < 210 and b < 110):
        return False
    # Color Wheel's yellow rim matches this pixel on a dimmed board too.
    # Confirm the quit dialog text before CANCEL can preempt mini-games.
    text = ocr_region((100, 650, 980, 1750), psm=11).upper()
    return bool(re.search(r"\bQUIT\b", text) and
                (re.search(r"\bGAME\b", text) or re.search(r"\bCANCEL\b", text)))

def _is_orange_x_color(rgb):
