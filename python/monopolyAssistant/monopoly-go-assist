def _boutique_state():
    if not _is_boutique_board():return None
    image=screen_image()
    board=[]; materials=set()
    for row in range(8):
        cells=[]
        for col in range(8):
            x,y=160+109*col,785+109*row
            r,g,b=image.getpixel((x,y))
            if _boutique_gold((r,g,b)):
                cells.append(1)
            elif 85 <= r <= 130 and 50 <= g <= 95 and 125 <= b <= 190 and b > r+25:
                cells.append(0)
            else:
                pixels=[image.getpixel((x+dx,y+dy)) for dy in range(-45,46,3) for dx in range(-45,46,3)]
                teal=sum(50<cr<180 and 100<cg<220 and 90<cb<220 and cg>cr+15 and cb>cr+10 for cr,cg,cb in pixels)/len(pixels)
                if teal < 0.2:return None
                cells.append(1);materials.add((row,col))
        board.append(tuple(cells))
    count=ocr_region((535,2060,605,2140),psm=7).strip()
    if not re.fullmatch(r'\d{1,3}',count):
        return None
    pieces=[]
    for slot,(left,right) in enumerate(((180,385),(430,665),(690,915))):
        def material(rgb):
            r,g,b=rgb[:3]
            return 60 < r < 165 and 105 < g < 205 and 100 < b < 205 and g > r+20 and b > r+15
        points=[(x,y) for y in range(1780,2005,2) for x in range(left,right,2)
                if _boutique_gold(image.getpixel((x,y))) or material(image.getpixel((x,y)))]
        if not points:continue
        x0=min(x for x,y in points);x1=max(x for x,y in points)
        y0=min(y for x,y in points);y1=max(y for x,y in points)
        w=round((x1-x0+2)/45);h=round((y1-y0+2)/45)
        if not (1 <= w <= 5 and 1 <= h <= 5 and abs(x1-x0+2-w*45)<12 and abs(y1-y0+2-h*45)<12):return None
        shape=[];carried=[]
        for rr in range(h):
            for cc in range(w):
                x=round(x0+(cc+0.5)*(x1-x0+2)/w)
                y=round(y0+(rr+0.5)*(y1-y0+2)/h)
                pixels=[image.getpixel((x+dx,y+dy)) for dy in range(-15,16,3) for dx in range(-15,16,3)]
                gold=sum(_boutique_gold(v) for v in pixels)/len(pixels)
                teal=sum(material(v) for v in pixels)/len(pixels)
                if gold > 0.6:shape.append((rr,cc))
                elif teal > 0.12:
                    shape.append((rr,cc));carried.append((rr,cc))
                elif gold+teal > 0.05:return None
        if not shape:return None
        # Pieces must be one connected shape; reject debris/unclear drawer geometry.
        seen={shape[0]};pending=[shape[0]]
        while pending:
            r,c=pending.pop()
            for point in ((r-1,c),(r+1,c),(r,c-1),(r,c+1)):
                if point in shape and point not in seen:seen.add(point);pending.append(point)
        if len(seen) != len(shape):return None
        grab=min(shape,key=lambda rc:(rc[0]-(h-1)/2)**2+(rc[1]-(w-1)/2)**2)
        source=(round(x0+(grab[1]+0.5)*(x1-x0+2)/w),round(y0+(grab[0]+0.5)*(y1-y0+2)/h))
        pieces.append((slot,w,h,source,tuple(shape),tuple(carried),grab))
    return tuple(board),frozenset(materials),int(count),tuple(pieces)


def _boutique_placements(board,w,h,shape=None):
    if shape is None:shape=tuple((r,c) for r in range(h) for c in range(w))
    return [(r,c) for r in range(9-h) for c in range(9-w)
            if all(not board[r+rr][c+cc] for rr,cc in shape)]


def _boutique_move(board,materials,pieces):
    best=None
    for piece in pieces:
        slot,w,h,source=piece[:4]
        shape=piece[4] if len(piece)>4 else tuple((r,c) for r in range(h) for c in range(w))
        carried=piece[5] if len(piece)>5 else ()
        for row,col in _boutique_placements(board,w,h,shape):
            filled=[list(r) for r in board]
            for r,c in shape:filled[row+r][col+c]=1
            rows={r for r in range(8) if all(filled[r])}
            cols={c for c in range(8) if all(filled[r][c] for r in range(8))}
            targets=set(materials)|{(row+r,col+c) for r,c in carried}
            collected=sum(r in rows or c in cols for r,c in targets)
            for r in range(8):
                for c in range(8):
                    if r in rows or c in cols:filled[r][c]=0
            mobility=sum(len(_boutique_placements(filled,p[1],p[2],p[4] if len(p)>4 else None)) for p in pieces if p[0] != slot)
            score=(collected*1000+(len(rows)+len(cols))*100+mobility, -row,-col,-slot)
            candidate=(score,slot,row,col,w,h,source,tuple(tuple(r) for r in filled))
            if best is None or score > best[0]:best=candidate
    return best


def _boutique_drag(source,destination):
    """Only exact game focus; always release touch, including failures."""
    down=False
    try:
        for event,point in (('DOWN',source),('MOVE',destination)):
            focus=subprocess.run([ADB,'shell','dumpsys','window'],capture_output=True,text=True,timeout=5)
            if focus.returncode or not _game_has_focus(focus.stdout):return False
            # Purchase screens are rejected before this routine by the state gate.
            down=True
            result=subprocess.run([ADB,'shell','input','motionevent',event,str(point[0]),str(point[1])],capture_output=True,timeout=5)
            if result.returncode:return False
        time.sleep(1)
        return True
    except (OSError,subprocess.TimeoutExpired):
        return False
    finally:
        if down:
            # UP releases an existing touch; it must run even if focus changed.
            try:subprocess.run([ADB,'shell','input','motionevent','UP',str(destination[0]),str(destination[1])],capture_output=True,timeout=5)
            except (OSError,subprocess.TimeoutExpired):pass


def _boutique_transition_label(text):
    upper=re.sub(r'[^A-Z0-9]+',' ',text.upper()).strip()
    if re.search(r'\b(?:BUY|PURCHASE|USD|GBP|EUR)\b',upper) or any(c in text for c in '$??'):
        return None
    if 'GRAND PRIZE' in upper and 'FILL 1 ROW AND 1 COLUMN' in upper:
        return 'NEXT'
    if 'RECIPE COMPLETE' in upper and 'BLOCKS' in upper and 'BOUTIQUE' in upper:
        return 'COLLECT'
    return None


def _handle_boutique_transition():
    image=screen_image()
    if image.size != (1080,2340):return False
    r,g,b=image.getpixel((500,100))
    pink=r>170 and b>180 and g<150
    r,g,b=image.getpixel((540,560))
    banner=b>170 and r<150 and g>100 and b>g+50
    if not (pink or banner):return False
    title=ocr_region((350,200,750,290),psm=6)
    if 'GRAND PRIZE' in title.upper():
        text=title+' '+ocr_region((260,405,850,480),psm=6)
    else:
        text=ocr_region((100,150,980,750),psm=11)
    label=_boutique_transition_label(text)
    if label is None:return False
    report_phase('boutique_transition')
    button=find_green_button(y_start=2000,y_end=2280)
    if button:
        x,y=button
        for box in ((x-220,y-65,x+220,y+65),(x-220,y+10,x+220,y+81),(x-240,y-4,x+240,y+106)):
            if re.fullmatch(r'[\s()\[\]|]*'+label+r'[\s()\[\]|]*',ocr_region(box,psm=6).strip().upper()):
                tap(*button);time.sleep(3);return True
    # A recognized transition blocks generic BUILD/popup handlers while animating.
    time.sleep(2);return True


def handle_boutique():
    global _BOUTIQUE_LAST_FRAME
    if _handle_boutique_transition():return True
    if os.environ.get("MONOPOLY_BOUTIQUE_AUTOPLAY") != "1" and _is_boutique_board():
        report_phase("boutique_deferred_for_review");time.sleep(5);return True
    state=_boutique_state()
    if state is None:
        if _is_boutique_board():
            report_phase("boutique_waiting_for_review");time.sleep(5);return True
        return False
    board,materials,count,pieces=state
    report_phase('boutique_blocks')
    if count == 0:
        print('Boutique event tokens exhausted; leaving without purchasing a refill.')
        game_back();time.sleep(2);return True
    signature=(board,pieces,count)
    if signature == _BOUTIQUE_LAST_FRAME or signature in _BOUTIQUE_FAILED:
        report_phase('boutique_waiting_for_review');time.sleep(5);return True
    move=_boutique_move(board,materials,pieces)
    if move is None:
        print('Boutique has no verified legal placement; waiting without spending.')
        _BOUTIQUE_FAILED.add(signature);time.sleep(5);return True
    _,slot,row,col,w,h,source,expected=move
    # Ghost placement center is about 400px above the finger in this layout.
    piece=next(p for p in pieces if p[0] == slot)
    grab=piece[6] if len(piece)>6 else ((h-1)/2,(w-1)/2)
    destination=(round(105+109*(col+grab[1]+0.5)),round(730+109*(row+grab[0]+0.5)+400))
    print(f'Boutique: placing observed {w}x{h} shape {slot} at row={row}, col={col}; tokens={count}.')
    _BOUTIQUE_LAST_FRAME=signature
    if not _boutique_drag(source,destination):
        _BOUTIQUE_FAILED.add(signature);return True
    time.sleep(3);screenshot()
    after=_boutique_state()
    if after is not None:
        if after[0] != expected or after[2] != count-1:
            print('Boutique outcome differs from prediction; stopping placements for review.')
            _BOUTIQUE_FAILED.add((after[0],after[3],after[2]))
        else:
            print(f'Boutique placement verified; tokens={after[2]}.')
    return True


def _house_board_title(text):
