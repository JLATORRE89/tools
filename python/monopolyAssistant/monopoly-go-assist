def _multiplier_consensus(readings):
    """Require two complete x-number readings; never translate letters to digits."""
    values = []
    for text in readings:
        match = re.fullmatch(r"x\s*([0-9]{1,4})", text.strip(), re.IGNORECASE)
        if not match:
            return None
        values.append(int(match.group(1)))
    if len(values) == 2 and values[0] == values[1] and 1 <= values[0] <= MULTIPLIER_SANITY_MAX:
        return values[0]
    return None


_multiplier_preferred_box = None


def _multiplier_ocr_fallback():
    """Re-read the glyphs without the badge rim, in color and a white-text mask."""
    global _multiplier_preferred_box
    from PIL import ImageOps
    image = screen_image()
    cache_key = ('multiplier_consensus',)
    if cache_key in _ocr_cache:
        return _ocr_cache[cache_key]
    readings = []
    boxes = [(694, 1722, 772, 1779), (700, 1725, 775, 1780), (700, 1730, 770, 1778)]
    if _multiplier_preferred_box in boxes:
        boxes.remove(_multiplier_preferred_box)
        boxes.insert(0, _multiplier_preferred_box)
    for box in boxes:
        crop = image.crop(box).resize(((box[2] - box[0]) * 4, (box[3] - box[1]) * 4))
        mask = crop.point(lambda p: 255 if p > 235 else 0).convert("L").point(
            lambda p: 0 if p > 240 else 255)
        pair = []
        for variant in (crop, mask):
            pair.append(ocr_image(ImageOps.expand(variant, border=20, fill="white")))
        readings.extend(pair)
        value = _multiplier_consensus(pair)
        if value is not None:
            _multiplier_preferred_box = box
            _ocr_cache[cache_key] = (value, " / ".join(readings))
            return _ocr_cache[cache_key]
    _ocr_cache[cache_key] = (None, " / ".join(readings))
    return _ocr_cache[cache_key]



def get_multiplier():
    """Accept only two complete matching badge readings, never stray digits."""
    value, readings = _multiplier_ocr_fallback()
    return value, f"consensus: {readings}"


def _game_has_focus(window_dump):
    lines = [line for line in window_dump.splitlines() if 'mCurrentFocus=' in line]
    return len(lines) == 1 and re.search(
        r'\bu\d+ com\.scopely\.monopolygo/', lines[0]) is not None


def tap(x, y):
    # Recheck immediately before every tap, including nested reward handlers.
    try:
        focus = subprocess.run([ADB, 'shell', 'dumpsys', 'window'],
                               capture_output=True, text=True, timeout=5)
        if focus.returncode or not _game_has_focus(focus.stdout):
            print("Game lacks confirmed focus; blocking tap (payment/overlay protection).")
            return False
    except (OSError, subprocess.TimeoutExpired):
        print("Window focus unavailable; blocking tap.")
        return False
    return sh(f"{ADB} shell input tap {x} {y}").returncode == 0

def game_back():
    """Navigate back only while the game, not billing or another app, has focus."""
    try:
        focus = subprocess.run([ADB, 'shell', 'dumpsys', 'window'],
                               capture_output=True, text=True, timeout=5)
        if focus.returncode or not _game_has_focus(focus.stdout):
            return False
        result = subprocess.run([ADB, 'shell', 'input', 'keyevent', 'KEYCODE_BACK'],
                                capture_output=True, timeout=5)
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


class PopupRecovery:
    def __init__(self):
        self.first_seen = None
        self.attempts = 0

    def clear(self):
        self.first_seen = None
        self.attempts = 0

    def handle(self):
        now = time.monotonic()
        if self.first_seen is None:
            self.first_seen = now
        # Give animations time to clear before navigating away.
        if now - self.first_seen >= 15 and self.attempts < 2:
            self.attempts += 1
            report_phase('recovering_popup')
            print(f'Unknown popup: guarded Android Back attempt {self.attempts}/2.')
            game_back()
        else:
            report_phase('unknown_popup')
        if now - self.first_seen >= 60:
            record_diagnostic('unknown_popup')
        # Observe short animations promptly, without navigating before 15s.
        # Once both guarded attempts are exhausted, reduce idle CPU usage.
        time.sleep(2 if self.attempts < 2 else 15)


_popup_recovery = PopupRecovery()


def _keep_screen_awake():
    """Wake only. Lock screens/overlays require explicit user dismissal."""
    sh(f"{ADB} shell input keyevent KEYCODE_WAKEUP")
    # Do not swipe blindly across billing sheets, overlays, or the game.

def sleep_keeping_awake(total_s, interval_s=15):
    """Sleeps for total_s, periodically waking/unlocking the screen so it
    doesn't time out and lock during a long wait with no taps to keep it
    awake naturally (critical for the multi-hour roll-empty backoff). Also
    checks for and handles the BUILD badge and card popups at each
    interval - confirmed live (2026-09-06) that a plain blind sleep here
    meant BUILD was never opened for the entire 2h wait even when its
    badge was showing, even though building only needs banked cash, not
    rolls. Also ends the wait early if the roll pill has refilled -
    confirmed live (2026-09-07) that rolls can be topped up externally
    (e.g. a free shop reward gave +29 rolls) mid-backoff, and without this
    check the bot would sit idle for up to the rest of the full 2h even
    with rolls sitting ready. Also handles raid/match3/bonus-roll/switch-
    opponent-menu at each interval (added 2026-09-07) - confirmed live a
    raid can appear right as the loop enters backoff (the raid screen
    occludes the roll pill, causing a false 'empty' reading), and without
    this it sat unaddressed for the rest of a 2h wait."""
    elapsed = 0.0
    purchase_guard = PurchaseLoopGuard()
    while elapsed < total_s:
        chunk = min(interval_s, total_s - elapsed)
        time.sleep(chunk)
        elapsed += chunk
        _keep_screen_awake()
        screenshot()
        if handle_spooky_express():
            continue
        if handle_treasure():
            continue
        if handle_boutique():
            continue
        if handle_house_choices():
            continue
        if handle_railroad_chance():
            continue
        modal = is_card_popup_screen()
        if modal and is_wins_screen():
            cmd_check_wins()
            continue
        if not modal:
            _popup_recovery.clear()
        if purchase_guard.handle(modal, find_orange_x_button() if modal else None):
            continue
        if is_quit_dialog_present():
            print("Quit-game dialog detected during backoff wait (unexpected) - tapping CANCEL.")
            tap(*CANCEL_BUTTON)
            continue
        # Checked next, same as the main loop - a COLLECT/GO! button is
        # always safe to grab regardless of what else is going on, per
        # explicit user direction, and previously nothing caught this
        # during the backoff wait at all.
        if is_collect_screen():
            report_phase('collecting_reward')
            print("COLLECT reward popup detected during backoff wait - tapping it.")
            _drain_collect_popups()
            continue
        if is_pick_a_box_screen():
            # Handled automatically as of 2026-09-15 (see cmd_pick_a_box()
            # - supersedes the old manual-only conclusion in RULES.md).
            # Previously this occluded the roll pill and got misread as
            # "rolls empty", which is how a real backoff-wait session
            # ended up stuck here for the entire 7200s window in the
            # first place.
            report_phase('handling_event')
            print("Pick a Box mini-event detected during backoff wait - handling it.")
            result = cmd_pick_a_box()
            if result == 0:
                screenshot()
                if get_roll_fill_ratio() >= ROLL_RATIO_EMPTY:
                    print("Pick a Box cleared with rolls available - ending backoff wait.")
                    return
            continue
        # Specific mini-games must precede BUILD: their grass/art can
        # match its broad pixel fallback (live Pick a Box, 2026-09-18).
        if is_bonus_roll_screen():
            report_phase('handling_event')
            print("Bonus 'Roll Doubles' event detected during backoff wait - tapping its ROLL button.")
            tap(*BONUS_ROLL_BUTTON)
            time.sleep(1.0)
            continue
        if is_color_wheel_screen():
            report_phase('handling_event')
            print("Color Wheel bonus spinner detected during backoff wait - tapping SPIN.")
            tap(*SPIN_BUTTON)
            time.sleep(2.0)
            continue
        if is_switch_opponent_menu():
            print("Switch-opponent menu detected during backoff wait - picking Random Player.")
            tap(*RANDOM_PLAYER_GO_BUTTON)
            time.sleep(1.2)
            continue
        if is_match3_screen():
            report_phase('handling_event')
            print("Match-3 mini-game detected during backoff wait - playing it.")
            cmd_match3()
            time.sleep(1.0)
            continue
        if is_raid_screen():
            # Confirmed live 2026-09-07: a raid can appear right as the
            # loop enters a long backoff (misreading the pill as empty
            # because the raid screen occludes it), and with nothing
            # handling raids during the wait it sat unaddressed for the
            # rest of the 2h - this is the fix.
            report_phase('handling_event')
            print("Raid screen detected during backoff wait - handling it.")
            cmd_raid()
            time.sleep(1.5)
            continue
        if is_build_menu_open():
            report_phase('closing_build')
            print("BUILD menu found open during backoff wait - closing it.")
            close_build_menu()
            if get_roll_fill_ratio() >= ROLL_RATIO_EMPTY:
                return
            continue
        if is_card_popup_screen():
            _popup_recovery.handle()
            continue
        if maybe_check_wins():
            continue
        if maybe_check_side_free_items():
            continue
        # Return to rolling before considering another build visit.
        ratio = get_roll_fill_ratio()
        if ratio >= ROLL_RATIO_EMPTY:
            print(f"Rolls have replenished (fill ratio {ratio:.2f}) during backoff wait - ending wait early.")
            return
        if is_build_badge_present():
            report_phase('building_while_waiting')
            cmd_build()
        report_phase('waiting_for_dice')
        _keep_screen_awake()

def long_press(x, y, duration_s=2.5):
    sh(f"{ADB} shell input motionevent DOWN {x} {y}")
    steps = max(1, int(duration_s / 0.24))
    for _ in range(steps):
        time.sleep(0.24)
        sh(f"{ADB} shell input motionevent MOVE {x} {y}")
    sh(f"{ADB} shell input motionevent UP {x} {y}")

def _roll_action():
    """Simplified rule (per live testing): single-tap whenever there's
    anything in the pill at all. Only skip tapping when it's genuinely
    empty (0/0) - in that case signal the caller to back off rather than
    busy-poll, since we can't reliably OCR the countdown timer either.
    Assumes a screenshot has already been taken.

    Does NOT do its own retry/settle logic - an empty reading here can
    also mean we're mid-transition into a raid/match3/bonus-roll/collect
    screen (those have no roll pill either), not genuinely 0 rolls. Since
    an empty result now triggers a full ROLL_EMPTY_BACKOFF_S (2h) sleep,
    that distinction matters a lot - see _settle_before_long_backoff(),
    called by cmd_loop() before it actually commits to sleeping."""
    ratio = get_roll_fill_ratio()
    print(f"roll pill fill ratio: {ratio:.2f}")
    if ratio < ROLL_RATIO_EMPTY:
        print("Pill reads empty (0/0). Not tapping - back off and recheck later.")
        return 2  # distinct code: "empty, caller should back off"
    print("Rolls available: sending GO tap (not confirmation of a completed roll).")
    tap(*GO_BUTTON)
    return 0

def _settle_before_long_backoff(max_wait_s=25, interval_s=3.0):
    """Before committing to the long (multi-hour) empty-rolls backoff,
    keep re-checking for a while in case we're actually mid-transition
    into a raid/match3/bonus-roll/collect/pick-a-box screen rather than
    genuinely idle on the main board with 0 rolls. Confirmed live
    (2026-09-06): a raid's intro crane/transition animation outlasted a much shorter
    (2.5s) double-check gap, so both quick checks landed mid-animation and
    falsely confirmed 'empty' - nearly wasting a full 2h sleep instead of
    handling a real raid with 3 targets. Polling for up to max_wait_s
    across all known screen types (not just re-checking the pill) is a
    more thorough guard. Returns True if genuinely still empty/idle after
    the full wait, False if a recognized screen appeared (caller should
    handle that instead of sleeping)."""
    waited = 0.0
    while waited < max_wait_s:
        time.sleep(interval_s)
        waited += interval_s
        screenshot()
        if (is_quit_dialog_present() or is_build_menu_open() or is_card_popup_screen()  # covers purchase upsells too - both are dimmed
                or is_switch_opponent_menu()  # now OCR-confirmed, safe as a top-level check again (2026-09-07)
                or is_collect_screen()
                or is_color_wheel_screen() or is_match3_screen()
                or is_bonus_roll_screen()
                or is_pick_a_box_screen()  # added 2026-09-15 - occludes the roll pill same as the others, and is NOT covered by is_card_popup_screen() (confirmed this screen doesn't dim, it replaces the top bar - see is_pick_a_box_screen())
                or is_raid_screen()):  # is_collect_screen covers BOARD COMPLETE too
            return False
        if get_roll_fill_ratio() >= ROLL_RATIO_EMPTY:
            return False
    return True

def cmd_roll():
    screenshot()
    return _roll_action()

def _multiplier_probe_blocked():
    """True if some other screen/popup is currently up that the multiplier
    badge coordinate shouldn't be tapped through (assumes a screenshot has
    already been taken). Reuses the same detectors cmd_loop() checks before
    ever reaching _multiplier_action(), so a probe in progress (which taps
    several times across its own screenshots, unlike the rest of the loop)
    re-verifies this before every single tap rather than trusting that
    nothing changed since the probe started."""
    return (
        is_quit_dialog_present()
        or is_collect_screen()
        or is_pick_a_box_screen()
        or is_bonus_roll_screen()
        or is_color_wheel_screen()
        or is_switch_opponent_menu()
        or is_match3_screen()
        or is_raid_screen()
        or is_build_menu_open()
        or is_card_popup_screen()  # covers is_purchase_upsell_screen() too
    )

def _probe_multiplier_max():
    """Bounded, observed cycling to find the multiplier's actual current
    cap - never assumes a fixed x3. Taps once, re-screenshots, and
    compares: as long as the reading keeps climbing, the cap hasn't been
    hit yet. The first tap that makes the reading go DOWN reveals a
    wrap-around back toward x1 - the value seen right before that drop was
    the true cap - and this taps back up to settle there. Returns the
    confirmed max (int) on success, or None if it couldn't be confirmed
    (unreadable badge, an unrelated popup appeared mid-probe, or the
    tap-back-to-max step didn't land) - callers must not guess/fall back to
    a stale value in that case, just try again later. Bounded by
    MULTIPLIER_MAX_PROBE_TAPS total taps and never touches GO_BUTTON."""
    screenshot()
    mult, raw = get_multiplier()
    print(f"multiplier detected: {mult} (raw OCR: {raw!r}) - probing for current max.")
    if mult is None:
        print("Could not read multiplier via OCR. No action taken.")
        record_diagnostic('multiplier_unreadable')
        return None

    seen_max = mult
    taps = 0
    while taps < MULTIPLIER_MAX_PROBE_TAPS:
        screenshot()
        if _multiplier_probe_blocked():
            print(f"An unrelated popup/dialog appeared mid-probe; stopping "
                  f"without further tapping (last confirmed value: x{seen_max}).")
            return None
        tap(*MULTIPLIER_BADGE)
        taps += 1
        time.sleep(MULTIPLIER_PROBE_SETTLE_S)
        screenshot()
        new_mult, raw = get_multiplier()
        if new_mult is None:
            print(f"Badge unreadable after tap {taps}; stopping rather than "
                  f"tapping blind (last confirmed value: x{seen_max}).")
            return None
        print(f"after probe tap {taps}: multiplier = x{new_mult} (raw OCR: {raw!r})")
        if new_mult < seen_max:
            gap = seen_max - new_mult
            print(f"Wrap-around detected (x{seen_max} -> x{new_mult}); true "
                  f"max is x{seen_max}. Tapping {gap} more time(s) to return to it.")
            cur = new_mult
            while cur < seen_max and taps < MULTIPLIER_MAX_PROBE_TAPS:
                screenshot()
                if _multiplier_probe_blocked():
                    print(f"An unrelated popup/dialog appeared while returning to "
                          f"max; stopping at x{cur} rather than tapping through it.")
                    return None
                tap(*MULTIPLIER_BADGE)
                taps += 1
                time.sleep(MULTIPLIER_PROBE_SETTLE_S)
                screenshot()
                cur, raw = get_multiplier()
                if cur is None:
                    print("Badge unreadable while returning to max; stopping.")
                    return None
            if cur == seen_max:
                print(f"Settled at observed max: x{seen_max}.")
                return seen_max
            print(f"WARNING: expected to land back on x{seen_max} but read "
                  f"x{cur}; not confirmed, leaving as-is.")
            return None
        seen_max = max(seen_max, new_mult)
    print(f"Hit the {MULTIPLIER_MAX_PROBE_TAPS}-tap safety bound without "
          f"observing a wrap-around; treating highest confirmed reading "
          f"x{seen_max} as unconfirmed; stopping without caching a cap.")
    return None

_multiplier_cache = {"max": None, "probed_at_tick": None}

def _multiplier_action(tick=0):
    """Assumes a screenshot has already been taken. Taps the multiplier
    badge up to its currently-available cap. The cap is not hardcoded: it
    is established via the bounded _probe_multiplier_max() cycle and
    cached, rather than re-probed every tick, EXCEPT when the on-screen
    reading exceeds what we last confirmed (the game itself is showing
    something above our cached cap) or MULTIPLIER_REPROBE_TICKS have
    passed since the last probe (catches a boosted-rewards event raising
    the cap mid-session without re-probing, and thus briefly dropping to
    x1 while re-climbing, on every single tick)."""
    mult, raw = get_multiplier()
    print(f"multiplier detected: {mult} (raw OCR: {raw!r})")
    if mult is None:
        print("Could not read multiplier via OCR. No action taken.")
        return 1

    if _last_die_detected:
        # Game allows selecting x3 with 1 die but resets to x1 on GO.
        # Re-probing that reset causes an endless badge cycle.
        for attempt in range(3):
            if mult == 1:
                print('Confirmed last die: using x1 without a maximum probe.')
                return 0
            if _multiplier_probe_blocked():
                return 1
            tap(*MULTIPLIER_BADGE)
            time.sleep(MULTIPLIER_PROBE_SETTLE_S)
            screenshot()
            mult, _ = get_multiplier()
            if mult is None:
                return 1
        return 0 if mult == 1 else 1

    known_max = _multiplier_cache["max"]
    due_for_reprobe = (
        known_max is None
        or mult != known_max
        or _multiplier_cache["probed_at_tick"] is None
        or tick - _multiplier_cache["probed_at_tick"] >= MULTIPLIER_REPROBE_TICKS
    )
    if due_for_reprobe:
        if time.monotonic() < _multiplier_cache.get("retry_after", 0):
            print("Multiplier verification cooling down; no badge or GO taps.")
            return 1
        _multiplier_cache["retry_after"] = time.monotonic() + 60
        probed = _probe_multiplier_max()
        if probed is not None:
            _multiplier_cache["max"] = probed
            _multiplier_cache["probed_at_tick"] = tick
            # The probe already settled at the maximum. The earlier reading is stale.
            return 0
        # A popup or unreadable badge can interrupt a re-probe. Never tap based
        # on the old reading/cache after it failed.
        _multiplier_cache["max"] = None
        _multiplier_cache["probed_at_tick"] = None
        return 1

    if mult >= known_max:
        print(f"Already at observed max (x{known_max}). Not tapping (would reset to x1).")
        return 0
    print("Tapping multiplier to increase.")
    tap(*MULTIPLIER_BADGE)
    return 0

def cmd_multiplier():
    screenshot()
    return _multiplier_action()

def cmd_multiplier_max():
    """Manual/verification entry point: run exactly one bounded probe pass
    and report the confirmed max, without relying on or mutating the
    cross-tick cache that cmd_loop() uses (so it's safe to run standalone
    against a live device for verification)."""
    result = _probe_multiplier_max()
    return 0 if result is not None else 1

def cmd_status():
    screenshot()
    ratio = get_roll_fill_ratio()
    mult, raw2 = get_multiplier()
    print(f"roll pill fill ratio: {ratio:.2f} ({'EMPTY' if ratio < ROLL_RATIO_EMPTY else 'has rolls'})")
    print(f"multiplier: {mult} (raw: {raw2!r})")
    return 0

_last_build_visit = float("-inf")
BUILD_VISIT_COOLDOWN_S = 30
_build_close_retry_after = 0.0


def close_build_menu():
    """Bounded close, with a fresh frame before and after every action."""
    global _build_close_retry_after
    if time.monotonic() < _build_close_retry_after:
        report_phase('build_close_cooldown')
        time.sleep(15)
        return 1
    for attempt in range(4):
        screenshot()
        if not is_build_menu_open():
            return 0
        print(f"Closing confirmed BUILD menu (attempt {attempt + 1}/4).")
        tap(*BUILD_CLOSE_X)
        time.sleep(1.0)
    screenshot()
    if not is_build_menu_open():
        return 0
    print('BUILD close button failed; trying guarded Android Back once.')
    if game_back():
        time.sleep(1.0)
        screenshot()
        if not is_build_menu_open():
            return 0
    _build_close_retry_after = time.monotonic() + 60
    report_phase('build_close_cooldown')
    print('WARNING: BUILD close failed; no further close taps for 60s.')
    return 1


def cmd_build(rounds=2):
    """Bounded build visit: confirm the menu, recheck each tap, then close.

    At most two rounds or ten seconds of card actions per visit. A 30s
    cooldown prevents a persistent badge from monopolizing gameplay.
    Specific event detection guards opening from a stale board frame.
    """
    global _last_build_visit
    screenshot()
    opened = is_build_menu_open()
    if not opened and time.monotonic() - _last_build_visit < BUILD_VISIT_COOLDOWN_S:
        return 0
    _last_build_visit = time.monotonic()
    if not opened:
        # Never use the badge sampled before GO: a reward/animation can
        # replace the board between the roll and this build visit.
        if _multiplier_probe_blocked():
            return 1
        print("Opening BUILD menu.")
        tap(*BUILD_ICON)
        for _ in range(4):
            time.sleep(0.6)
            screenshot()
            if is_build_menu_open():
                opened = True
                break
        if not opened:
            print("BUILD opening not confirmed; no card taps, retry after cooldown.")
            return 1
    deadline = time.monotonic() + 10
    for _ in range(min(rounds, 2)):
        for x in BUILD_CARD_XS:
            screenshot()
            if not is_build_menu_open():
                print("BUILD screen changed; returning to main screen handling.")
                return 0
            if time.monotonic() >= deadline:
                return close_build_menu()
            tap(x, BUILD_CARD_Y)
            time.sleep(0.15)
    return close_build_menu()


def maybe_build_before_roll(tick):
    """Visit BUILD on the evaluated board, never immediately after GO."""
    if time.monotonic() - _last_build_visit < BUILD_VISIT_COOLDOWN_S:
        return False
    if not is_build_badge_present() and not (tick > 0 and tick % 277 == 0):
        return False
    report_phase('building_before_roll')
    cmd_build()
    # Always re-evaluate after a visit, including failed opens or a board change.
    return True


def cmd_match3():
    """Blind-flip all 12 tiles in the 'Match 3 to steal' mini-game grid.
    No memory/strategy - just reveals everything in order. Matches happen
    by chance as pairs/triples line up; good enough for 'handle the basics'
    without a full solver.

    Per-tap delay is 0.25s (down from 0.7s, 2026-09-07 speed-up request) -
    same reasoning as cmd_build: this is a fixed static grid, no screen
    transition between taps, so it doesn't need transition settle time."""
    print("Flipping all 12 tiles in the match-3 grid.")
    for y in MATCH3_TILE_YS:
        for x in MATCH3_TILE_XS:
            tap(x, y)
            time.sleep(0.25)
    return 0

class PurchaseLoopGuard:
    """Cap dismissal attempts across chained offers until the modal clears."""
    def __init__(self):
        self.attempts = 0

    def handle(self, modal, close_button):
        if not modal:
            self.attempts = 0
            return False
        if close_button is None:
            return False
        if self.attempts < 2:
            self.attempts += 1
            report_phase("closing_purchase_popup")
            print(f"Purchase popup: close-only attempt {self.attempts}/2.")
            tap(*close_button)
            time.sleep(1.2)
        else:
            report_phase("purchase_popup_blocked")
            print("Purchase popup persists; pausing taps until the screen clears.")
            time.sleep(15)
        return True


def cmd_loop(interval_s=0.35):
    """Tie it all together: dismiss any Chance/Community Chest/other card
    popup (dimmed-board overlay, any interior color/content), keep
    rolling, top up the multiplier, open BUILD whenever its red badge
    shows something is affordable/pending (with a ~6min fixed-interval
    fallback in case that detector ever misses), auto-detect + play the
    match-3 mini-game whenever it appears, handle the purple-button 'Roll
    Doubles' bonus event (which has no roll pill - without this check
    cmd_roll() reads it as empty and gets stuck), handle raid/heist
    target-selection screens by tapping a detected target reticle (does
    NOT avoid smoke/cooldown targets - still requires visual judgment this
    doesn't attempt; falls back to SWITCH OPPONENT if no target is found),
    and auto-dismiss the green COLLECT reward popup afterward. Backs off
    for ROLL_EMPTY_BACKOFF_S (2h, to let ~10 rolls bank up rather than
    waking for every single one) only once _settle_before_long_backoff()
    confirms the empty reading isn't just a mid-transition frame - a false
    positive is now expensive. During that wait, periodically wakes/
    unlocks the screen so a long idle stretch with no taps doesn't let the
    phone's screen timeout lock it out. Runs until killed (Ctrl-C or an
    external stop)."""
    print(f"Starting continuous loop (card-popup dismissal + roll + "
          f"multiplier + badge-driven build + match-3 auto-play + "
          f"bonus-roll-event + raid-target tapping + collect-popup "
          f"dismissal), checking every {interval_s}s. Ctrl-C to stop.")
    global _continuous_mode
    _continuous_mode = True
    tick = 0
    purchase_guard = PurchaseLoopGuard()
    try:
        while True:
            screenshot()
            report_phase("evaluating_screen")
            if handle_spooky_express():
                continue
            if handle_treasure():
                continue
            if handle_boutique():
                continue
            if handle_house_choices():
                continue
            if handle_railroad_chance():
                continue
            modal = is_card_popup_screen()
            if modal and is_wins_screen():
                cmd_check_wins()
                continue
            if not modal:
                _popup_recovery.clear()
            if purchase_guard.handle(modal, find_orange_x_button() if modal else None):
                continue
            if is_quit_dialog_present():
                print("Quit-game dialog detected (unexpected) - tapping CANCEL.")
                tap(*CANCEL_BUTTON)
                time.sleep(1.0)
                continue
            # Checked next, before every other screen type: a COLLECT/GO!
            # button is always safe to grab (pure reward, no downside) and
            # per explicit user direction should be tapped "regardless of
            # the screen" rather than only reached after ruling out every
            # other branch - a chained reward popup can appear on top of
            # almost any other state.
            if is_collect_screen():
                report_phase('collecting_reward')
                print("COLLECT reward popup detected - tapping it.")
                _drain_collect_popups()
                continue
            if is_pick_a_box_screen():
                # Handled automatically as of 2026-09-15 (see
                # cmd_pick_a_box() - supersedes RULES.md's older "5
                # touch-injection techniques all failed" conclusion; those
                # attempts targeted the crates' own coordinates rather
                # than GO_BUTTON, which is what turned out to work).
                # Checked before the generic card-popup branch below so it
                # doesn't waste cycles/log spam repeatedly center-tapping
                # and X-fallback tapping a screen that has its own
                # dedicated handler.
                if cmd_pick_a_box() != 0:
                    time.sleep(PICK_A_BOX_FAILURE_BACKOFF_S)
                continue
            if is_bonus_roll_screen():
                # Checked before the generic card-popup branch below -
                # confirmed live 2026-09-11 this screen dims the board
                # (matches is_card_popup_screen() too), and since that
                # generic check used to run first, it was swallowing this
                # event every time with an ineffective center-tap,
                # stuck-cycling "Card popup detected... Still showing..."
                # forever and never once reaching this branch. Moved
                # switch-opponent/match3/raid up alongside it for the same
                # reason, even though only bonus-roll was confirmed stuck
                # live - all four have their own dedicated tap target the
                # generic center-tap/close-X fallback can't substitute for.
                print("Bonus 'Roll Doubles' event detected - tapping its ROLL button.")
                tap(*BONUS_ROLL_BUTTON)
                time.sleep(1.0)
                continue
            if is_color_wheel_screen():
                report_phase('handling_event')
                print("Color Wheel bonus spinner detected - tapping SPIN.")
                tap(*SPIN_BUTTON)
                time.sleep(2.5)
                continue
            if is_switch_opponent_menu():
                # Now OCR-confirmed (not just color), safe as a top-level
                # check again - re-added 2026-09-07 after confirming live
                # this screen can otherwise sit stuck indefinitely. Checked
                # before the generic card-popup branch below - moved
                # 2026-09-11 alongside match3/bonus-roll/raid (see note
                # there for why).
                print("Switch-opponent menu detected - picking Random Player.")
                tap(*RANDOM_PLAYER_GO_BUTTON)
                time.sleep(1.2)
                continue
            if is_match3_screen():
                print("Match-3 mini-game detected - playing it.")
                cmd_match3()
                time.sleep(1.0)
                continue
            if is_raid_screen():
                cmd_raid()
                time.sleep(1.5)
                continue
            # Specific mini-games must precede BUILD: their grass/art can
            # match its broad pixel fallback (live Pick a Box, 2026-09-18).
            if is_build_menu_open():
                report_phase('closing_build')
                print("BUILD menu found open (unexpectedly) - closing it.")
                close_build_menu()
                continue
            if is_card_popup_screen():
                # Generic fallback for any OTHER dimmed popup we don't
                # have a specific handler for (Chance/Community Chest
                # etc.) - kept last among the popup-handling checks, after
                # every screen type with its own dedicated tap target
                # above, since a plain center-tap/close-X can't substitute
                # for those (see note on the bonus-roll check above).
                # Only search for the orange X once we already know we're
                # on SOME dimmed popup - searching unconditionally every
                # tick false-positived against the (undimmed) main board's
                # Farm Express icon, confirmed live 2026-09-07.
                _popup_recovery.handle()
                continue
            if maybe_check_wins():
                continue
            if maybe_check_side_free_items():
                continue
            # No dice means no useful multiplier probe. The game may reset
            # its badge at zero; cycling it here prevented reaching backoff.
            if get_roll_fill_ratio() < ROLL_RATIO_EMPTY:
                if _settle_before_long_backoff():
                    report_phase("waiting_for_dice")
                    print("No dice available; monitoring every 15s without multiplier taps.")
                    cleanup_temp_images()
                    sleep_keeping_awake(ROLL_EMPTY_BACKOFF_S)
                    _keep_screen_awake()
                continue
            if maybe_build_before_roll(tick):
                continue
            if _multiplier_action(tick) != 0:
                time.sleep(interval_s)
                continue
            screenshot()
            if _multiplier_probe_blocked():
                continue
            report_phase("rolling")
            roll_result = _roll_action()
            if roll_result == 2:
                if _settle_before_long_backoff():
                    print(f"Backing off {ROLL_EMPTY_BACKOFF_S}s (rolls empty).")
                    cleanup_temp_images()
                    sleep_keeping_awake(ROLL_EMPTY_BACKOFF_S)
                    _keep_screen_awake()
                else:
                    print("Screen changed during settle-check - re-evaluating immediately.")
                continue
            tick += 1
            # Store badges persist after free gifts and can cause purchase loops.
            # Shop visits are explicit-only; never reopen them from this loop.
            time.sleep(interval_s)
    except KeyboardInterrupt:
        print("Loop stopped.")
    finally:
        _continuous_mode = False
        report_phase("stopped")
    return 0

