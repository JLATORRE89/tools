    return _pick_a_box_ocr_matches(ocr_region(PICK_A_BOX_OCR_REGION))

PICK_A_BOX_TAP_RETRIES = 3
PICK_A_BOX_POLL_S = 1.5
PICK_A_BOX_POLL_ROUNDS = 7  # ~10.5s of polling per tap attempt
PICK_A_BOX_FAILURE_BACKOFF_S = 60

def cmd_pick_a_box():
    """Handles the 'Infinite Harvest / PICK A BOX' mini-event by tapping
    GO_BUTTON (539,1901).

    SUPERSEDES RULES.md's 2026-09-07 "manual-only" conclusion. New live
    evidence 2026-09-15: while the loop was stuck in a 7200s empty-roll
    backoff on this exact screen (see is_pick_a_box_screen() above for why
    it never even recognized it), a plain `adb shell input tap 539 1901`
    completed the box-pick - confirmed via a before/after screenshot pair
    (crates open with revealed contents, then the screen returns to the
    normal main board). That's the SAME `input tap` primitive already
    tried and dismissed as non-working back on 2026-09-07. The likely
    difference: those five earlier attempts tapped coordinates read off
    the crates' own on-screen position, which apparently weren't precise
    enough to land inside this Unity element's real hit target - a
    targeting problem, not a fundamental touch-injection block. GO_BUTTON
    is used here (rather than re-deriving a fresh per-crate coordinate)
    because it's this script's most heavily-calibrated, most-tapped point,
    and the live before/after screenshots confirm one of the (3-4) crates
    always sits over it, so it reliably lands on a real crate.

    SAFETY: only ever called after is_pick_a_box_screen() has confirmed
    via OCR that we're genuinely on this screen (both call sites below
    check that first) - this never taps blind on an unrecognized popup, so
    it can't be confused with the purchase-upsell path (which has its own
    separate, OCR/orange-X-gated handling and is never routed through
    here).

    Does NOT assume one tap = done: the after-tap screenshot still reads
    as "PICK A BOX" (OCR-wise) for a few seconds while the picked crate's
    contents animate open, before the screen auto-transitions back to the
    main board - confirmed live via the before/after screenshot pair. A
    single immediate re-check can't tell "tap missed" apart from "tap
    landed, reveal still animating", so this polls for up to
    PICK_A_BOX_POLL_ROUNDS * PICK_A_BOX_POLL_S seconds for the screen to
    actually leave this event (or a reward COLLECT popup to appear)
    before concluding the tap needs to be retried. Bounded to
    PICK_A_BOX_TAP_RETRIES total tap attempts rather than tapping forever,
    in case GO_BUTTON's overlap with a real crate ever stops holding
    (reskin, layout shift, or a genuine touch-injection miss) - falls back
    to a pause between later attempts if still stuck after that."""
    for attempt in range(1, PICK_A_BOX_TAP_RETRIES + 1):
        print(f"Pick a Box screen detected - tapping GO_BUTTON {GO_BUTTON} "
              f"(attempt {attempt}/{PICK_A_BOX_TAP_RETRIES}).")
        tap(*GO_BUTTON)
        for _ in range(PICK_A_BOX_POLL_ROUNDS):
            time.sleep(PICK_A_BOX_POLL_S)
            screenshot()
            if is_collect_screen():
                print("Pick a Box reward popup detected - tapping it.")
                _drain_collect_popups()
                return 0
            if not is_pick_a_box_screen():
                print("Pick a Box screen cleared after tap.")
                return 0
        print(f"Still on Pick a Box screen after tap + "
              f"{PICK_A_BOX_POLL_ROUNDS * PICK_A_BOX_POLL_S:.0f}s poll "
              f"(attempt {attempt}/{PICK_A_BOX_TAP_RETRIES}).")
    print(f"WARNING: Pick a Box screen still showing after "
          f"{PICK_A_BOX_TAP_RETRIES} tap attempts at GO_BUTTON - "
          f"pausing before the next check. If this keeps happening, the "
          f"GO_BUTTON/crate overlap may have shifted - recalibrate against "
          f"a fresh live screenshot rather than guessing (see RULES.md).")
    return 1

