from datetime import datetime

# Timestamp every event, not only supervisor restarts.
def print(*args, **kwargs):
    kwargs.setdefault('flush', True)
    builtins.print(datetime.now().astimezone().isoformat(timespec='seconds'), *args, **kwargs)

_continuous_mode = False
_phase = None
_phase_since = 0.0
_phase_reported = 0.0
_performance = {}
_performance_reported = 0.0


def record_timing(name, elapsed):
    count, total = _performance.get(name, (0, 0.0))
    _performance[name] = (count + 1, total + elapsed)


def report_performance(now):
    global _performance_reported
    if os.environ.get('MONOPOLY_METRICS') != '1' or now - _performance_reported < 60:
        return
    if _performance:
        print('PERF ' + ' '.join(f'{name}_count={n} {name}_avg_s={seconds/n:.3f}'
                                for name, (n, seconds) in sorted(_performance.items())))
        _performance.clear()
    _performance_reported = now

def report_phase(name):
    global _phase, _phase_since, _phase_reported
    now = time.monotonic()
    report_performance(now)
    if name != _phase:
        if _phase is not None:
            print(f'STATE_END {_phase} elapsed_s={now - _phase_since:.1f}')
        _phase, _phase_since = name, now
        print(f'STATE_BEGIN {name}')
        _phase_reported = now
    elif now - _phase_reported >= 60:
        print(f'STATE_HEARTBEAT {name} elapsed_s={now - _phase_since:.1f}')
        _phase_reported = now


